    fram:hasAspect model:aspect_precondition_node_f25 ;
    fram:hasAspect model:aspect_resource_node_f25 ;
    fram:hasAspect model:aspect_control_node_f25 ;
    fram:hasAspect model:aspect_time_node_f25 ;
    fram:hasVariability model:function_node_f25_variability ;
    fram:quantitativeMetadata model:function_node_f25_qm .

model:aspect_input_node_f25 a fram:InputAspect ;
    fram:aspectType "Input" ;
    fram:aspectCode "I" ;
    fram:semanticRole "What activates the function or what the function processes/transforms" ;
    rdfs:comment "Input (I) is that which the function processes or transforms, \nor that which starts or triggers the function. The Input activates the function \nand/or provides the material (physical or informational) that the function processes.\nExamples: A signal, a request, raw materials, data, a patient arriving." ;
    fram:hasCoupling model:coupling_edge_f24_f25 .

model:aspect_output_node_f25 a fram:OutputAspect ;
    fram:aspectType "Output" ;
    fram:aspectCode "O" ;
    fram:semanticRole "The result or product of the function's execution" ;
    rdfs:comment "Output (O) is that which is the result of the function, either \nas an entity or as a state change. The Output is typically what the function is \nsupposed to produce or achieve, and it serves as Input, Precondition, Resource, \nControl, or Time for downstream functions.\nExamples: A product, a decision, information, a state change, a treated patient." .

model:aspect_precondition_node_f25 a fram:PreconditionAspect ;
    fram:aspectType "Precondition" ;
    fram:aspectCode "P" ;
    fram:semanticRole "Conditions that must exist before the function can execute" ;
    rdfs:comment "Precondition (P) represents the conditions that must be verified \nto exist before a function can be carried out. Preconditions are system conditions \nthat must be fulfilled, rather than things that are used or consumed.\nExamples: Access rights verified, safety checks completed, equipment ready, \nenvironmental conditions met." .

model:aspect_resource_node_f25 a fram:ResourceAspect ;
    fram:aspectType "Resource" ;
    fram:aspectCode "R" ;
    fram:semanticRole "What the function needs or consumes during execution" ;
    rdfs:comment "Resource (R) is what the function needs when it is carried out \nor what it consumes to produce the Output. Unlike Preconditions, Resources are \ntypically used up or occupied during function execution.\nExamples: Tools, equipment, energy, money, manpower, software, time allocation." .

model:aspect_control_node_f25 a fram:ControlAspect ;
    fram:aspectType "Control" ;
    fram:aspectCode "C" ;
    fram:semanticRole "How the function is monitored, supervised, or regulated" ;
    rdfs:comment "Control (C) is how the function is monitored, supervised, or \nregulated so that it can adjust to produce the required Output. Control represents \nthe regulation or governance of the function.\nExamples: Procedures, guidelines, supervisory oversight, feedback loops, \nmonitoring systems, regulations." .

model:aspect_time_node_f25 a fram:TimeAspect ;
    fram:aspectType "Time" ;
    fram:aspectCode "T" ;
    fram:semanticRole "Temporal aspects affecting the function's execution" ;
    rdfs:comment "Time (T) represents the various temporal aspects that affect \nhow a function is carried out. This can include duration constraints, deadlines, \nsynchronization requirements, or temporal dependencies.\nExamples: Deadlines, time windows, synchronization with other functions, \nsequence requirements, duration limits." .

model:function_node_f25_variability a fram:Variability ;
    fram:variabilityPotential "Moderate" ;
    fram:timingPhenotype "OnTime" ;
    fram:precisionPhenotype "Acceptable" ;
    rdfs:comment "Estimated moderate variability potential based on function type and connectivity" ;
    fram:factors "Human performance inherently variable" ;
    fram:factors "Subject to fatigue, attention, and cognitive load" .

model:function_node_f25_qm a fram:QuantitativeMetadata ;
    fram:hasVariable [ a fram:Variable ;
        schema:name "PERF_F25" ;
        fram:expression "(PERF_F24 || 1) * rnorm(1, 0.02)" ;
        fram:codeType "expression" ;
        rdfs:comment "Performance variability for F25 - End of the Transfer (K-shell: 0, σ=0.02)" ;
        fram:semanticMeaning "Performance variability for F25 - End of the Transfer (K-shell: 0, σ=0.02)" ;
        fram:dependencies "PERF_F24" ;
        fram:sourceType "calculated" ] ;
    fram:hasInterpretationProfile [ a fram:InterpretationProfile ;
        fram:input "ANY" ;
        fram:precondition "NONE" ;
        fram:resource "NONE" ;
        fram:time "NONE" ;
        fram:control "NONE" ;
        rdfs:comment "Defines how incoming aspects are interpreted for function activation" ] .

