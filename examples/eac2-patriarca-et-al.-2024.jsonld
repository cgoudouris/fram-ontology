            "@type": "Variable",
            "name": "PERF_F07",
            "expression": "(PERF_F02 || 1) * (PERF_F05 || 1) * (PERF_F06 || 1) * (PERF_F12 || 1) * NOMINAL_PRECISION",
            "codeType": "expression",
            "description": "Precision propagation (Eq.19) for F07",
            "semanticMeaning": "Precision propagation (Eq.19) for F07"
          },
