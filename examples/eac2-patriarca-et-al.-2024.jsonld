            "name": "DC2_MARGINAL_PROB",
            "value": 0.666667,
            "dataType": "xsd:decimal",
            "description": "DC2(iii): marginal P(each output) = 2^(k-1)/(2^k-1)",
            "semanticMeaning": "DC2(iii): marginal P(each output) = 2^(k-1)/(2^k-1)"
