            "semanticMeaning": "DC2(iii): 3 non-empty subsets from 2 outputs"
          },
          {
            "@type": "Constant",
            "name": "DC2_MARGINAL_PROB",
            "value": 0.6,
            "dataType": "xsd:decimal",
            "description": "DC2 sensitivity (sigma-high): perturbed marginal prob = 0.600000",
            "semanticMeaning": "DC2 sensitivity (sigma-high): perturbed marginal prob = 0.600000"
          },
          {
            "@type": "Constant",
            "name": "NOMINAL_PRECISION",
            "value": 1,
            "dataType": "xsd:integer",
            "description": "Nominal precision for F07",
            "semanticMeaning": "Nominal precision for F07"
          },
          {
            "@type": "Constant",
            "name": "VISIT_PROB_NOMINAL",
            "value": 0.09090909090909091,
            "dataType": "xsd:decimal",
            "description": "p_0 = 4/42 (Article Sect 4.3.1)",
            "semanticMeaning": "p_0 = 4/42 (Article Sect 4.3.1)"
