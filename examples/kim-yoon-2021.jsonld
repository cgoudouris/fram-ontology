  "@id": "model:model_default",
  "@type": "FRAMModel",
  "name": "COVID-19 Emergency Response — Kim & Yoon (2021)",
  "description": "FRAM model of South Korea COVID-19 emergency response with stochastic variability propagation. Based on Kim & Yoon (2021) RESS 214, 107745. DOI: 10.1016/j.ress.2021.107745. 14 functions (F1, F14 background; rest organizational/foreground), 32 couplings, 3 scenarios. Methodology: per-cycle |N(0, IEV_P²)| sampling via Box-Muller, per-function aggregation rules (multiplicative/additive/min/max) reading upstream OVs from previous cycle via flow.get (handles feedback loops), dampening at threshold θ, halt at OV > 10 (post-process). 1 FlowFRAM iteration = 1 article cycle; run scenario N times for N trials. Expected behavior: F5 = resonance sink; F7, F10 = high-variability hotspots.",
  "version": "1.0",
  "dateCreated": "2026-04-24T02:55:55.748Z",
  "dateModified": "2026-04-24T02:55:55.748Z",
  "about": "Functional Resonance Analysis Method (FRAM) model for socio-technical system analysis",
  "keywords": [
    "FRAM",
    "safety",
    "resilience",
    "socio-technical systems"
  ],
  "analysisType": "prospective",
  "methodologyContext": {
    "framPrinciples": [
      {
        "principle": "Equivalence of Successes and Failures",
        "description": "Things that go right and things that go wrong happen in basically \nthe same way. Adverse outcomes (accidents, incidents) happen because something \ngoes wrong, i.e., because of malfunctions, failures, or errors. Things that go \nwell happen because the performance, or the functions, match the demands, \ni.e., because functions do what they are supposed to do.",
        "reference": "Hollnagel, E. (2012), Chapter 2"
      },
      {
        "principle": "Approximate Adjustments",
        "description": "People - and organisations - have to adjust what they do to match \nthe actual conditions, resources and demands. Since resources and time are finite, \nsuch adjustments will always be approximate. Because the adjustments are approximate, \nthey will also be variable - and this variability is essential for safety.",
        "reference": "Hollnagel, E. (2012), Chapter 3"
      },
      {
        "principle": "Emergence",
        "description": "Both wanted and unwanted outcomes are emergent phenomena, arising \nfrom the variability of everyday performance - also called normal performance \nvariability. The variability of multiple functions may combine in unexpected ways, \nleading to disproportionately large consequences. This is called functional resonance.",
        "reference": "Hollnagel, E. (2012), Chapter 4"
      },
      {
        "principle": "Functional Resonance",
        "description": "Functional resonance is defined as the detectable signal that emerges \nfrom the unintended interaction of the variability of many functions. Functional resonance \ncan lead to both positive and negative outcomes. The resonance is not caused by failures \nor malfunctions, but by the normal variability of functions.",
        "reference": "Hollnagel, E. (2012), Chapter 5"
      }
    ],
    "aspectDefinitions": {
      "Input": {
        "code": "I",
        "name": "Input",
        "fullDescription": "Input (I) is that which the function processes or transforms, \nor that which starts or triggers the function. The Input activates the function \nand/or provides the material (physical or informational) that the function processes.\nExamples: A signal, a request, raw materials, data, a patient arriving.",
        "semanticRole": "What activates the function or what the function processes/transforms",
        "questions": [
          "What starts this function?",
          "What does this function process or transform?",
          "What triggers the execution of this function?"
        ]
      },
      "Output": {
        "code": "O",
        "name": "Output",
        "fullDescription": "Output (O) is that which is the result of the function, either \nas an entity or as a state change. The Output is typically what the function is \nsupposed to produce or achieve, and it serves as Input, Precondition, Resource, \nControl, or Time for downstream functions.\nExamples: A product, a decision, information, a state change, a treated patient.",
        "semanticRole": "The result or product of the function's execution",
        "questions": [
          "What does this function produce?",
          "What is the result of this function?",
          "What state change does this function create?"
        ]
      },
      "Precondition": {
        "code": "P",
        "name": "Precondition",
        "fullDescription": "Precondition (P) represents the conditions that must be verified \nto exist before a function can be carried out. Preconditions are system conditions \nthat must be fulfilled, rather than things that are used or consumed.\nExamples: Access rights verified, safety checks completed, equipment ready, \nenvironmental conditions met.",
        "semanticRole": "Conditions that must exist before the function can execute",
        "questions": [
          "What conditions must be true before this function can start?",
          "What must be verified before execution?",
          "What system states are prerequisites?"
        ]
      },
      "Resource": {
        "code": "R",
        "name": "Resource",
        "fullDescription": "Resource (R) is what the function needs when it is carried out \nor what it consumes to produce the Output. Unlike Preconditions, Resources are \ntypically used up or occupied during function execution.\nExamples: Tools, equipment, energy, money, manpower, software, time allocation.",
        "semanticRole": "What the function needs or consumes during execution",
        "questions": [
          "What does this function consume?",
          "What resources are needed for execution?",
          "What is used up or occupied during this function?"
        ]
      },
      "Control": {
        "code": "C",
        "name": "Control",
        "fullDescription": "Control (C) is how the function is monitored, supervised, or \nregulated so that it can adjust to produce the required Output. Control represents \nthe regulation or governance of the function.\nExamples: Procedures, guidelines, supervisory oversight, feedback loops, \nmonitoring systems, regulations.",
        "semanticRole": "How the function is monitored, supervised, or regulated",
        "questions": [
          "How is this function monitored?",
          "What procedures or guidelines govern this function?",
          "How is the function adjusted during execution?"
        ]
      },
      "Time": {
        "code": "T",
        "name": "Time",
        "fullDescription": "Time (T) represents the various temporal aspects that affect \nhow a function is carried out. This can include duration constraints, deadlines, \nsynchronization requirements, or temporal dependencies.\nExamples: Deadlines, time windows, synchronization with other functions, \nsequence requirements, duration limits.",
        "semanticRole": "Temporal aspects affecting the function's execution",
        "questions": [
          "When must this function be performed?",
          "How long should this function take?",
          "What temporal constraints affect this function?"
        ]
      }
    },
    "commonPerformanceConditions": {
      "description": "Common Performance Conditions (CPCs) are factors that are known to \naffect human and organizational performance. They provide a structured way to \ncharacterize the conditions under which functions are performed, and thereby \nassess the potential for variability.",
      "conditions": [
        {
          "name": "Availability of Resources",
          "description": "Whether required resources (tools, materials, staff) are available when needed",
          "levels": [
            "Adequate",
            "Temporarily inadequate",
            "Permanently inadequate"
          ],
          "impact": "Affects precision and timing of function execution"
        },
        {
          "name": "Training and Experience",
          "description": "The level of training and operational experience of personnel",
          "levels": [
            "Adequate, high experience",
            "Adequate, limited experience",
            "Inadequate"
          ],
          "impact": "Affects ability to handle variability and adapt to conditions"
        },
        {
          "name": "Quality of Communication",
          "description": "Effectiveness of information exchange within and between functions",
          "levels": [
            "Adequate",
            "Acceptable",
            "Inadequate"
          ],
          "impact": "Affects coordination and error detection"
        },
        {
          "name": "Human-Machine Interface",
          "description": "Quality of interfaces between humans and technical systems",
          "levels": [
            "Supportive",
            "Acceptable",
            "Inappropriate"
          ],
          "impact": "Affects perception, decision-making, and action execution"
        },
        {
          "name": "Access to Procedures",
          "description": "Availability and quality of procedures and guidelines",
          "levels": [
            "Appropriate and available",
            "Available but inappropriate",
            "Not available"
          ],
          "impact": "Affects consistency and correctness of function execution"
        },
        {
          "name": "Working Conditions",
          "description": "Physical and environmental conditions during work",
          "levels": [
            "Advantageous",
            "Compatible",
            "Incompatible"
          ],
