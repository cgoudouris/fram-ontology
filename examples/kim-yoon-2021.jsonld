            "@type": "Variable",
            "name": "OV_F02",
            "expression": "((iev) => { const r = (OV_F13 ?? 1); const av = r * iev; return (av <= THETA) ? Math.max(1, iev) : av; })(Math.abs(Math.sqrt(-2 * Math.log(Math.max(Math.random(), 1e-10))) * Math.cos(2 * Math.PI * Math.random()) * IEV_P))",
            "codeType": "expression",
