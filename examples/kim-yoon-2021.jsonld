      "quantitativeMetadata": {
        "constants": [
          {
            "@type": "Constant",
            "name": "IEV_P",
            "value": 0.8,
            "dataType": "xsd:decimal",
            "description": "Potential internal/external variability std (Table 3, scenario-overridable)",
            "semanticMeaning": "Potential internal/external variability std (Table 3, scenario-overridable)"
          },
          {
            "@type": "Constant",
            "name": "THETA",
            "value": 2.4,
            "dataType": "xsd:decimal",
            "description": "Variability threshold θ (Table 3). If r·IEV ≤ θ the function dampens.",
            "semanticMeaning": "Variability threshold θ (Table 3). If r·IEV ≤ θ the function dampens."
          }
        ],
        "variables": [
          {
            "@type": "Variable",
            "name": "OV_F08",
            "expression": "((iev) => { const r = ((OV_F06 ?? 1) * (((OV_F03 ?? 1) - 1) + ((OV_F07 ?? 1) - 1) + ((OV_F11 ?? 1) - 1) + 1)); const av = r * iev; return (av <= THETA) ? Math.max(1, iev) : av; })(Math.abs(Math.sqrt(-2 * Math.log(Math.max(Math.random(), 1e-10))) * Math.cos(2 * Math.PI * Math.random()) * IEV_P))",
            "codeType": "expression",
            "description": "Output variability of F8 per cycle. Reads upstream OVs from previous cycle via flow.get (default 1). Stochastic |N(0, IEV_P²)| with dampening at θ. Persists own OV via flow.set for next cycle. Halt criterion: trial ends when any OV > 10 (post-process).",
            "semanticMeaning": "Output variability of F8 per cycle. Reads upstream OVs from previous cycle via flow.get (default 1). Stochastic |N(0, IEV_P²)| with dampening at θ. Persists own OV via flow.set for next cycle. Halt criterion: trial ends when any OV > 10 (post-process)."
          }
        ],
