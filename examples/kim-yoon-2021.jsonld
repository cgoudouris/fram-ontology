        "constants": [
          {
            "@type": "Constant",
            "name": "IEV_P",
            "value": 0.4,
            "dataType": "xsd:decimal",
            "description": "Potential internal/external variability std (Table 3, scenario-overridable)",
            "semanticMeaning": "Potential internal/external variability std (Table 3, scenario-overridable)"
          }
        ],
        "variables": [
          {
            "@type": "Variable",
            "name": "OV_F01",
            "expression": "Math.max(1, Math.abs(Math.sqrt(-2 * Math.log(Math.max(Math.random(), 1e-10))) * Math.cos(2 * Math.PI * Math.random()) * IEV_P))",
            "codeType": "expression",
            "description": "Output variability of F1 per cycle. Reads upstream OVs from previous cycle via flow.get (default 1). Stochastic |N(0, IEV_P²)| with dampening at θ. Persists own OV via flow.set for next cycle. Halt criterion: trial ends when any OV > 10 (post-process).",
            "semanticMeaning": "Output variability of F1 per cycle. Reads upstream OVs from previous cycle via flow.get (default 1). Stochastic |N(0, IEV_P²)| with dampening at θ. Persists own OV via flow.set for next cycle. Halt criterion: trial ends when any OV > 10 (post-process)."
          }
        ],
