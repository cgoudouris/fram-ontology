model:function_ddb3fe43_abfd_4122_a1bd_e6912ede619b_qm a fram:QuantitativeMetadata ;
    fram:hasConstant [ a fram:Constant ;
        schema:name "IEV_P" ;
        fram:value "0.4" ;
        fram:dataType "xsd:decimal" ;
        rdfs:comment "Potential internal/external variability std (Table 3, scenario-overridable)" ;
        fram:semanticMeaning "Potential internal/external variability std (Table 3, scenario-overridable)" ] ;
    fram:hasConstant [ a fram:Constant ;
        schema:name "THETA" ;
        fram:value "2" ;
        fram:dataType "xsd:integer" ;
        rdfs:comment "Variability threshold θ (Table 3). If r·IEV ≤ θ the function dampens." ;
        fram:semanticMeaning "Variability threshold θ (Table 3). If r·IEV ≤ θ the function dampens." ] ;
    fram:hasVariable [ a fram:Variable ;
        schema:name "OV_F13" ;
        fram:expression "((iev) => { const r = (((OV_F08 ?? 1) - 1) + ((OV_F09 ?? 1) - 1) + ((OV_F11 ?? 1) - 1) + 1); const av = r * iev; return (av <= THETA) ? Math.max(1, iev) : av; })(Math.abs(Math.sqrt(-2 * Math.log(Math.max(Math.random(), 1e-10))) * Math.cos(2 * Math.PI * Math.random()) * IEV_P))" ;
        fram:codeType "expression" ;
        rdfs:comment "Output variability of F13 per cycle. Reads upstream OVs from previous cycle via flow.get (default 1). Stochastic |N(0, IEV_P²)| with dampening at θ. Persists own OV via flow.set for next cycle. Halt criterion: trial ends when any OV > 10 (post-process)." ;
        fram:semanticMeaning "Output variability of F13 per cycle. Reads upstream OVs from previous cycle via flow.get (default 1). Stochastic |N(0, IEV_P²)| with dampening at θ. Persists own OV via flow.set for next cycle. Halt criterion: trial ends when any OV > 10 (post-process)." ] ;
    fram:hasInterpretationProfile [ a fram:InterpretationProfile ;
        fram:input "ANY" ;
        fram:precondition "NONE" ;
        fram:resource "NONE" ;
        fram:time "NONE" ;
        fram:control "NONE" ;
        rdfs:comment "Defines how incoming aspects are interpreted for function activation" ] ;
    fram:isCustomActivation "true"^^xsd:boolean .

