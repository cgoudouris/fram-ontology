model:model_default a fram:FRAMModel ;
    schema:name "COVID-19 Emergency Response — Kim & Yoon (2021)" ;
    rdfs:comment "FRAM model of South Korea COVID-19 emergency response with stochastic variability propagation. Based on Kim & Yoon (2021) RESS 214, 107745. DOI: 10.1016/j.ress.2021.107745. 14 functions (F1, F14 background; rest organizational/foreground), 32 couplings, 3 scenarios. Methodology: per-cycle |N(0, IEV_P²)| sampling via Box-Muller, per-function aggregation rules (multiplicative/additive/min/max) reading upstream OVs from previous cycle via flow.get (handles feedback loops), dampening at threshold θ, halt at OV > 10 (post-process). 1 FlowFRAM iteration = 1 article cycle; run scenario N times for N trials. Expected behavior: F5 = resonance sink; F7, F10 = high-variability hotspots." ;
    schema:version "1.0" ;
    schema:dateCreated "2026-04-24T02:56:09.067Z"^^xsd:dateTime ;
    fram:analysisType "prospective" ;
    fram:hasFunction model:function_3fa13b43_1112_4df9_8cd5_430ca51a24e3 ,
