model:function_746eb244_8161_43f6_9afa_1578820bbb76_qm a fram:QuantitativeMetadata ;
    fram:hasConstant [ a fram:Constant ;
        schema:name "IEV_P" ;
        fram:value "1.2" ;
        fram:dataType "xsd:decimal" ;
        rdfs:comment "Potential internal/external variability std (Table 3, scenario-overridable)" ;
        fram:semanticMeaning "Potential internal/external variability std (Table 3, scenario-overridable)" ] ;
    fram:hasConstant [ a fram:Constant ;
        schema:name "THETA" ;
        fram:value "1.2" ;
        fram:dataType "xsd:decimal" ;
        rdfs:comment "Variability threshold θ (Table 3). If r·IEV ≤ θ the function dampens." ;
        fram:semanticMeaning "Variability threshold θ (Table 3). If r·IEV ≤ θ the function dampens." ] ;
    fram:hasVariable [ a fram:Variable ;
        schema:name "OV_F03" ;
        fram:expression "((iev) => { const r = (OV_F02 ?? 1); const av = r * iev; return (av <= THETA) ? Math.max(1, iev) : av; })(Math.abs(Math.sqrt(-2 * Math.log(Math.max(Math.random(), 1e-10))) * Math.cos(2 * Math.PI * Math.random()) * IEV_P))" ;
        fram:codeType "expression" ;
        rdfs:comment "Output variability of F3 per cycle. Reads upstream OVs from previous cycle via flow.get (default 1). Stochastic |N(0, IEV_P²)| with dampening at θ. Persists own OV via flow.set for next cycle. Halt criterion: trial ends when any OV > 10 (post-process)." ;
        fram:semanticMeaning "Output variability of F3 per cycle. Reads upstream OVs from previous cycle via flow.get (default 1). Stochastic |N(0, IEV_P²)| with dampening at θ. Persists own OV via flow.set for next cycle. Halt criterion: trial ends when any OV > 10 (post-process)." ] ;
    fram:hasInterpretationProfile [ a fram:InterpretationProfile ;
        fram:input "NONE" ;
        fram:precondition "NONE" ;
        fram:resource "NONE" ;
        fram:time "NONE" ;
        fram:control "ANY" ;
        rdfs:comment "Defines how incoming aspects are interpreted for function activation" ] ;
    fram:isCustomActivation "true"^^xsd:boolean .

