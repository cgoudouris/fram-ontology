model:function_3fa13b43_1112_4df9_8cd5_430ca51a24e3_qm a fram:QuantitativeMetadata ;
    fram:hasConstant [ a fram:Constant ;
        schema:name "IEV_P" ;
        fram:value "0.4" ;
        fram:dataType "xsd:decimal" ;
        rdfs:comment "Potential internal/external variability std (Table 3, scenario-overridable)" ;
        fram:semanticMeaning "Potential internal/external variability std (Table 3, scenario-overridable)" ] ;
    fram:hasVariable [ a fram:Variable ;
        schema:name "OV_F01" ;
        fram:expression "Math.max(1, Math.abs(Math.sqrt(-2 * Math.log(Math.max(Math.random(), 1e-10))) * Math.cos(2 * Math.PI * Math.random()) * IEV_P))" ;
        fram:codeType "expression" ;
        rdfs:comment "Output variability of F1 per cycle. Reads upstream OVs from previous cycle via flow.get (default 1). Stochastic |N(0, IEV_P²)| with dampening at θ. Persists own OV via flow.set for next cycle. Halt criterion: trial ends when any OV > 10 (post-process)." ;
        fram:semanticMeaning "Output variability of F1 per cycle. Reads upstream OVs from previous cycle via flow.get (default 1). Stochastic |N(0, IEV_P²)| with dampening at θ. Persists own OV via flow.set for next cycle. Halt criterion: trial ends when any OV > 10 (post-process)." ] .

