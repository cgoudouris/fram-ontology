model:aspect_input_3fa13b43_1112_4df9_8cd5_430ca51a24e3 a fram:InputAspect ;
    fram:aspectType "Input" ;
    fram:aspectCode "I" ;
    fram:semanticRole "What activates the function or what the function processes/transforms" ;
    rdfs:comment "Input (I) is that which the function processes or transforms, \nor that which starts or triggers the function. The Input activates the function \nand/or provides the material (physical or informational) that the function processes.\nExamples: A signal, a request, raw materials, data, a patient arriving." .

model:aspect_output_3fa13b43_1112_4df9_8cd5_430ca51a24e3 a fram:OutputAspect ;
    fram:aspectType "Output" ;
    fram:aspectCode "O" ;
    fram:semanticRole "The result or product of the function's execution" ;
    rdfs:comment "Output (O) is that which is the result of the function, either \nas an entity or as a state change. The Output is typically what the function is \nsupposed to produce or achieve, and it serves as Input, Precondition, Resource, \nControl, or Time for downstream functions.\nExamples: A product, a decision, information, a state change, a treated patient." ;
