      "variability": {
        "@type": "Variability",
        "potential": "Moderate",
        "timingPhenotype": "OnTime",
        "precisionPhenotype": "Acceptable",
        "description": "Estimated moderate variability potential based on function type and connectivity",
        "factors": [
          "Human performance inherently variable",
          "Subject to fatigue, attention, and cognitive load"
        ]
      },
      "quantitativeMetadata": {
        "constants": [
          {
            "@type": "Constant",
            "name": "DC_E",
            "value": 0.000021,
            "dataType": "xsd:decimal",
            "description": "Risk pulse energy — Harsh environment",
            "semanticMeaning": "Risk pulse energy — Harsh environment"
          },
          {
            "@type": "Constant",
            "name": "DC_H",
            "value": 0.000069,
            "dataType": "xsd:decimal",
            "description": "Risk pulse energy — Human risk factors (annual casualties)",
            "semanticMeaning": "Risk pulse energy — Human risk factors (annual casualties)"
          }
        ],
        "variables": [
          {
            "@type": "Variable",
            "name": "OV_M5",
            "expression": "V_prime_M5 + V_transmitted_M5",
            "codeType": "expression",
            "description": "Total variability (self + transmitted) (Eq. 6)",
            "semanticMeaning": "Total variability (self + transmitted) (Eq. 6)"
          },
          {
            "@type": "Variable",
            "name": "P_up_M10",
            "expression": "(OV_M10 != null) ? (1 - Math.exp(-Math.pow(OV_M10, 2))) : 0",
            "codeType": "expression",
            "description": "Transmission probability from upstream M10 (Eq. 4)",
            "semanticMeaning": "Transmission probability from upstream M10 (Eq. 4)"
          },
          {
            "@type": "Variable",
            "name": "V_prime_M5",
            "expression": "Math.sqrt( (DC_H * DC_E) / (DC_H + DC_E) )",
            "codeType": "expression",
            "description": "Self-variability from coupled risk factors DC_H and DC_E (Eq. 3, W=2)",
            "semanticMeaning": "Self-variability from coupled risk factors DC_H and DC_E (Eq. 3, W=2)"
          },
          {
            "@type": "Variable",
            "name": "V_transmitted_M5",
            "expression": "((OV_M10 != null) ? OV_M10 * P_up_M10 : 0)",
            "codeType": "expression",
            "description": "Variability received from upstream (Eq. 5)",
            "semanticMeaning": "Variability received from upstream (Eq. 5)"
          }
        ],
        "outputs": [
          {
            "@type": "OutputMessage",
            "edgeId": "b5155339-515d-4c7f-a95d-994947a89d49",
            "targetFunction": "99c1298c-34eb-458f-ba9b-045af7c389af",
