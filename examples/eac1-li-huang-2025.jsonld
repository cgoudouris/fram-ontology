      "quantitativeMetadata": {
        "constants": [
          {
            "@type": "Constant",
            "name": "DC_H",
            "value": 0.000069,
            "dataType": "xsd:decimal",
            "description": "Risk pulse energy — Human risk factors (annual casualties)",
            "semanticMeaning": "Risk pulse energy — Human risk factors (annual casualties)"
          },
          {
            "@type": "Constant",
            "name": "DC_M1",
            "value": 0.0000752,
            "dataType": "xsd:decimal",
            "description": "Risk pulse energy — Machine and equipment failures",
            "semanticMeaning": "Risk pulse energy — Machine and equipment failures"
          }
        ],
        "variables": [
          {
            "@type": "Variable",
            "name": "OV_M8",
            "expression": "V_prime_M8 + V_transmitted_M8",
            "codeType": "expression",
            "description": "Total variability (self + transmitted) (Eq. 6)",
            "semanticMeaning": "Total variability (self + transmitted) (Eq. 6)"
          },
          {
            "@type": "Variable",
            "name": "P_up_M7",
            "expression": "(OV_M7 != null) ? (1 - Math.exp(-Math.pow(OV_M7, 2))) : 0",
            "codeType": "expression",
            "description": "Transmission probability from upstream M7 (Eq. 4)",
            "semanticMeaning": "Transmission probability from upstream M7 (Eq. 4)"
          },
          {
            "@type": "Variable",
            "name": "V_prime_M8",
            "expression": "Math.sqrt( (DC_H * DC_M1) / (DC_H + DC_M1) )",
            "codeType": "expression",
            "description": "Self-variability from coupled risk factors DC_H and DC_M1 (Eq. 3, W=2)",
            "semanticMeaning": "Self-variability from coupled risk factors DC_H and DC_M1 (Eq. 3, W=2)"
          },
          {
            "@type": "Variable",
            "name": "V_transmitted_M8",
            "expression": "((OV_M7 != null) ? OV_M7 * P_up_M7 : 0)",
            "codeType": "expression",
            "description": "Variability received from upstream (Eq. 5)",
            "semanticMeaning": "Variability received from upstream (Eq. 5)"
          }
        ],
