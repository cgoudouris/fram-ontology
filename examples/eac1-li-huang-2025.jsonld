        "variables": [
          {
            "@type": "Variable",
            "name": "OV_M10",
            "expression": "V_prime_M10",
            "codeType": "expression",
            "description": "Total variability — no upstream transmission (entry-like, only receives passthrough from M4)",
            "semanticMeaning": "Total variability — no upstream transmission (entry-like, only receives passthrough from M4)"
          },
          {
            "@type": "Variable",
            "name": "V_prime_M10",
            "expression": "Math.sqrt( (DC_M1 * DC_E) / (DC_M1 + DC_E) )",
            "codeType": "expression",
            "description": "Self-variability from coupled risk factors DC_M1 and DC_E (Eq. 3, W=2)",
