      "quantitativeMetadata": {
        "constants": [
          {
            "@type": "Constant",
            "name": "DC_H",
            "value": 0.000069,
            "dataType": "xsd:decimal",
            "description": "Risk pulse energy — Human risk factors (annual casualties)",
            "semanticMeaning": "Risk pulse energy — Human risk factors (annual casualties)"
          },
          {
            "@type": "Constant",
            "name": "DC_M2",
            "value": 0.000013,
            "dataType": "xsd:decimal",
            "description": "Risk pulse energy — Management failures",
            "semanticMeaning": "Risk pulse energy — Management failures"
          }
        ],
        "variables": [
          {
            "@type": "Variable",
            "name": "OV_M11",
            "expression": "V_prime_M11 + V_transmitted_M11",
            "codeType": "expression",
            "description": "Total variability (self + transmitted) (Eq. 6)",
            "semanticMeaning": "Total variability (self + transmitted) (Eq. 6)"
          },
          {
            "@type": "Variable",
            "name": "P_up_M5",
            "expression": "(OV_M5 != null) ? (1 - Math.exp(-Math.pow(OV_M5, 2))) : 0",
            "codeType": "expression",
            "description": "Transmission probability from upstream M5 (Eq. 4)",
            "semanticMeaning": "Transmission probability from upstream M5 (Eq. 4)"
          },
          {
            "@type": "Variable",
            "name": "V_prime_M11",
            "expression": "Math.sqrt( (DC_H * DC_M2) / (DC_H + DC_M2) )",
            "codeType": "expression",
            "description": "Self-variability from coupled risk factors DC_H and DC_M2 (Eq. 3, W=2)",
            "semanticMeaning": "Self-variability from coupled risk factors DC_H and DC_M2 (Eq. 3, W=2)"
          },
          {
            "@type": "Variable",
            "name": "V_transmitted_M11",
            "expression": "((OV_M5 != null) ? OV_M5 * P_up_M5 : 0)",
            "codeType": "expression",
            "description": "Variability received from upstream (Eq. 5)",
            "semanticMeaning": "Variability received from upstream (Eq. 5)"
          }
        ],
