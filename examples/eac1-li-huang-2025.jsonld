            "@type": "Variable",
            "name": "OV_M20",
            "expression": "((OV_M8 != null) ? OV_M8 * P_up_M8 : 0) + ((OV_M19 != null) ? OV_M19 * P_up_M19 : 0)",
            "codeType": "expression",
            "description": "Total variability — transmitted only",
            "semanticMeaning": "Total variability — transmitted only"
          },
          {
            "@type": "Variable",
            "name": "P_up_M8",
            "expression": "(OV_M8 != null) ? (1 - Math.exp(-Math.pow(OV_M8, 2))) : 0",
