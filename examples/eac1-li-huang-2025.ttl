model:function_38df716b_87d6_45a7_9354_a056c7b4bc07_qm a fram:QuantitativeMetadata ;
    fram:hasConstant [ a fram:Constant ;
        schema:name "DC_E" ;
        fram:value "0.000021" ;
        fram:dataType "xsd:decimal" ;
        rdfs:comment "Risk pulse energy — Harsh environment" ;
        fram:semanticMeaning "Risk pulse energy — Harsh environment" ] ;
    fram:hasConstant [ a fram:Constant ;
        schema:name "DC_H" ;
        fram:value "0.000069" ;
        fram:dataType "xsd:decimal" ;
        rdfs:comment "Risk pulse energy — Human risk factors (annual casualties)" ;
        fram:semanticMeaning "Risk pulse energy — Human risk factors (annual casualties)" ] ;
    fram:hasConstant [ a fram:Constant ;
        schema:name "DC_M1" ;
        fram:value "0.0000752" ;
        fram:dataType "xsd:decimal" ;
        rdfs:comment "Risk pulse energy — Machine and equipment failures" ;
        fram:semanticMeaning "Risk pulse energy — Machine and equipment failures" ] ;
    fram:hasVariable [ a fram:Variable ;
        schema:name "OV_M16" ;
        fram:expression "V_prime_M16 + V_transmitted_M16" ;
        fram:codeType "expression" ;
        rdfs:comment "Total variability (self + transmitted) (Eq. 6)" ;
        fram:semanticMeaning "Total variability (self + transmitted) (Eq. 6)" ] ;
    fram:hasVariable [ a fram:Variable ;
        schema:name "P_up_M10" ;
        fram:expression "(OV_M10 != null) ? (1 - Math.exp(-Math.pow(OV_M10, 2))) : 0" ;
        fram:codeType "expression" ;
        rdfs:comment "Transmission probability from upstream M10 (Eq. 4)" ;
        fram:semanticMeaning "Transmission probability from upstream M10 (Eq. 4)" ] ;
    fram:hasVariable [ a fram:Variable ;
        schema:name "V_prime_M16" ;
        fram:expression "Math.pow( (DC_H * DC_M1 * DC_E) / (DC_H + DC_M1 + DC_E), 1/3 )" ;
        fram:codeType "expression" ;
        rdfs:comment "Self-variability from coupled risk factors DC_H, DC_M1, DC_E (Eq. 3, W=3)" ;
        fram:semanticMeaning "Self-variability from coupled risk factors DC_H, DC_M1, DC_E (Eq. 3, W=3)" ] ;
    fram:hasVariable [ a fram:Variable ;
        schema:name "V_transmitted_M16" ;
        fram:expression "((OV_M10 != null) ? OV_M10 * P_up_M10 : 0)" ;
        fram:codeType "expression" ;
        rdfs:comment "Variability received from upstream (Eq. 5)" ;
        fram:semanticMeaning "Variability received from upstream (Eq. 5)" ] ;
    fram:hasInterpretationProfile [ a fram:InterpretationProfile ;
        fram:input "ANY" ;
        fram:precondition "NONE" ;
        fram:resource "ANY" ;
        fram:time "NONE" ;
        fram:control "ANY" ;
        rdfs:comment "Defines how incoming aspects are interpreted for function activation" ] ;
    fram:isCustomActivation "true"^^xsd:boolean .

