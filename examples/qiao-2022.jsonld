  "@id": "model:model_default",
  "@type": "FRAMModel",
  "name": "Maritime Emergency Response FRAM - Qiao et al. 2022 (with scenarios)",
  "description": "FRAM model with 10 degradation scenarios (Table 8 + extensions). 25 functions, 50 couplings. Scenarios: Baseline + 7 single-function degradations (σ×2) + combined stress + chain disruption. Designed to validate resilience sensitivity analysis against Qiao et al. (2022) Table 8.",
  "version": "1.0.0",
  "creator": "FlowFRAM",
  "dateCreated": "2026-04-23T18:49:44.173Z",
  "dateModified": "2026-04-23T18:49:44.174Z",
  "about": "Functional Resonance Analysis Method (FRAM) model for socio-technical system analysis",
  "keywords": [],
  "analysisType": "retrospective",
  "methodologyContext": {
    "framPrinciples": [
      {
        "principle": "Equivalence of Successes and Failures",
        "description": "Things that go right and things that go wrong happen in basically \nthe same way. Adverse outcomes (accidents, incidents) happen because something \ngoes wrong, i.e., because of malfunctions, failures, or errors. Things that go \nwell happen because the performance, or the functions, match the demands, \ni.e., because functions do what they are supposed to do.",
        "reference": "Hollnagel, E. (2012), Chapter 2"
      },
      {
        "principle": "Approximate Adjustments",
        "description": "People - and organisations - have to adjust what they do to match \nthe actual conditions, resources and demands. Since resources and time are finite, \nsuch adjustments will always be approximate. Because the adjustments are approximate, \nthey will also be variable - and this variability is essential for safety.",
        "reference": "Hollnagel, E. (2012), Chapter 3"
      },
      {
        "principle": "Emergence",
        "description": "Both wanted and unwanted outcomes are emergent phenomena, arising \nfrom the variability of everyday performance - also called normal performance \nvariability. The variability of multiple functions may combine in unexpected ways, \nleading to disproportionately large consequences. This is called functional resonance.",
        "reference": "Hollnagel, E. (2012), Chapter 4"
      },
      {
        "principle": "Functional Resonance",
        "description": "Functional resonance is defined as the detectable signal that emerges \nfrom the unintended interaction of the variability of many functions. Functional resonance \ncan lead to both positive and negative outcomes. The resonance is not caused by failures \nor malfunctions, but by the normal variability of functions.",
        "reference": "Hollnagel, E. (2012), Chapter 5"
      }
    ],
    "aspectDefinitions": {
      "Input": {
        "code": "I",
        "name": "Input",
        "fullDescription": "Input (I) is that which the function processes or transforms, \nor that which starts or triggers the function. The Input activates the function \nand/or provides the material (physical or informational) that the function processes.\nExamples: A signal, a request, raw materials, data, a patient arriving.",
        "semanticRole": "What activates the function or what the function processes/transforms",
        "questions": [
          "What starts this function?",
          "What does this function process or transform?",
          "What triggers the execution of this function?"
        ]
      },
      "Output": {
        "code": "O",
        "name": "Output",
        "fullDescription": "Output (O) is that which is the result of the function, either \nas an entity or as a state change. The Output is typically what the function is \nsupposed to produce or achieve, and it serves as Input, Precondition, Resource, \nControl, or Time for downstream functions.\nExamples: A product, a decision, information, a state change, a treated patient.",
        "semanticRole": "The result or product of the function's execution",
        "questions": [
          "What does this function produce?",
          "What is the result of this function?",
          "What state change does this function create?"
        ]
      },
      "Precondition": {
        "code": "P",
        "name": "Precondition",
        "fullDescription": "Precondition (P) represents the conditions that must be verified \nto exist before a function can be carried out. Preconditions are system conditions \nthat must be fulfilled, rather than things that are used or consumed.\nExamples: Access rights verified, safety checks completed, equipment ready, \nenvironmental conditions met.",
        "semanticRole": "Conditions that must exist before the function can execute",
        "questions": [
          "What conditions must be true before this function can start?",
          "What must be verified before execution?",
          "What system states are prerequisites?"
        ]
      },
      "Resource": {
        "code": "R",
        "name": "Resource",
        "fullDescription": "Resource (R) is what the function needs when it is carried out \nor what it consumes to produce the Output. Unlike Preconditions, Resources are \ntypically used up or occupied during function execution.\nExamples: Tools, equipment, energy, money, manpower, software, time allocation.",
        "semanticRole": "What the function needs or consumes during execution",
        "questions": [
          "What does this function consume?",
          "What resources are needed for execution?",
          "What is used up or occupied during this function?"
        ]
      },
      "Control": {
        "code": "C",
        "name": "Control",
        "fullDescription": "Control (C) is how the function is monitored, supervised, or \nregulated so that it can adjust to produce the required Output. Control represents \nthe regulation or governance of the function.\nExamples: Procedures, guidelines, supervisory oversight, feedback loops, \nmonitoring systems, regulations.",
        "semanticRole": "How the function is monitored, supervised, or regulated",
        "questions": [
          "How is this function monitored?",
          "What procedures or guidelines govern this function?",
          "How is the function adjusted during execution?"
        ]
      },
      "Time": {
        "code": "T",
        "name": "Time",
        "fullDescription": "Time (T) represents the various temporal aspects that affect \nhow a function is carried out. This can include duration constraints, deadlines, \nsynchronization requirements, or temporal dependencies.\nExamples: Deadlines, time windows, synchronization with other functions, \nsequence requirements, duration limits.",
        "semanticRole": "Temporal aspects affecting the function's execution",
        "questions": [
          "When must this function be performed?",
          "How long should this function take?",
          "What temporal constraints affect this function?"
        ]
      }
    },
    "commonPerformanceConditions": {
      "description": "Common Performance Conditions (CPCs) are factors that are known to \naffect human and organizational performance. They provide a structured way to \ncharacterize the conditions under which functions are performed, and thereby \nassess the potential for variability.",
      "conditions": [
        {
          "name": "Availability of Resources",
          "description": "Whether required resources (tools, materials, staff) are available when needed",
          "levels": [
            "Adequate",
            "Temporarily inadequate",
            "Permanently inadequate"
          ],
          "impact": "Affects precision and timing of function execution"
        },
        {
          "name": "Training and Experience",
          "description": "The level of training and operational experience of personnel",
          "levels": [
            "Adequate, high experience",
            "Adequate, limited experience",
            "Inadequate"
          ],
          "impact": "Affects ability to handle variability and adapt to conditions"
        },
        {
          "name": "Quality of Communication",
          "description": "Effectiveness of information exchange within and between functions",
          "levels": [
            "Adequate",
            "Acceptable",
            "Inadequate"
          ],
          "impact": "Affects coordination and error detection"
        },
        {
          "name": "Human-Machine Interface",
          "description": "Quality of interfaces between humans and technical systems",
          "levels": [
            "Supportive",
            "Acceptable",
            "Inappropriate"
          ],
          "impact": "Affects perception, decision-making, and action execution"
        },
        {
          "name": "Access to Procedures",
          "description": "Availability and quality of procedures and guidelines",
          "levels": [
            "Appropriate and available",
            "Available but inappropriate",
            "Not available"
          ],
          "impact": "Affects consistency and correctness of function execution"
        },
        {
          "name": "Working Conditions",
          "description": "Physical and environmental conditions during work",
          "levels": [
            "Advantageous",
            "Compatible",
            "Incompatible"
          ],
          "impact": "Affects attention, fatigue, and performance capacity"
        },
        {
          "name": "Number of Goals",
          "description": "Number of simultaneous goals or tasks to be achieved",
          "levels": [
            "Few",
            "Matching capacity",
            "Too many"
          ],
          "impact": "Affects attention distribution and prioritization"
        },
        {
          "name": "Available Time",
          "description": "Time available relative to time required for function execution",
          "levels": [
            "Adequate",
            "Temporarily inadequate",
            "Continuously inadequate"
          ],
          "impact": "Affects thoroughness and quality of execution"
        },
        {
          "name": "Circadian Rhythm",
          "description": "Alignment of work with natural circadian patterns",
          "levels": [
            "Day time (adjusted)",
            "Night time (unadjusted)",
            "Shift work"
          ],
          "impact": "Affects alertness, decision-making, and error rates"
        },
        {
          "name": "Crew Collaboration",
          "description": "Quality of teamwork and mutual support",
          "levels": [
            "Very efficient",
            "Efficient",
            "Inefficient",
            "Deficient"
          ],
          "impact": "Affects error detection, workload sharing, and resilience"
        },
        {
          "name": "Organizational Support",
          "description": "Support from the organization for safe and effective work",
          "levels": [
            "Effective",
            "Limited",
            "Absent"
          ],
          "impact": "Affects resources, training, and safety culture"
        }
      ]
    },
    "variabilityPhenotypes": {
      "description": "Variability phenotypes describe how the output of a function may vary. \nThe variability can be characterized along seven dimensions: timing, precision, duration, \nsequence, force, distance, and direction (Hollnagel, 2012; ontology v1.5.0).",
      "timing": {
        "description": "When the function produces its output relative to when it should",
        "phenotypes": [
          {
            "name": "Too Early",
            "description": "Output is produced before the optimal or expected time",
            "consequences": "May create dependencies on not-yet-ready inputs, coordination issues"
          },
          {
            "name": "On Time",
            "description": "Output is produced at the expected or optimal time",
            "consequences": "Nominal operation, expected coordination with other functions"
          },
          {
            "name": "Too Late",
            "description": "Output is produced after the optimal or expected time",
            "consequences": "May delay downstream functions, create time pressure"
          },
          {
            "name": "Not At All",
            "description": "Output is not produced (omission)",
            "consequences": "Downstream functions may be blocked or forced to adapt"
          }
        ]
      },
      "precision": {
        "description": "How accurately the function produces its intended output",
        "phenotypes": [
          {
            "name": "Precise",
            "description": "Output matches the intended specification exactly",
            "consequences": "Nominal operation, downstream functions receive expected input"
          },
          {
            "name": "Acceptable",
            "description": "Output is within acceptable tolerances but not exact",
            "consequences": "Downstream functions can compensate, minor adjustments needed"
          },
          {
            "name": "Imprecise",
            "description": "Output deviates significantly from intended specification",
            "consequences": "Downstream functions may fail or produce degraded output"
          }
        ]
      },
      "duration": {
        "description": "How long the function takes to produce its output",
        "phenotypes": [
          {
            "name": "Too Short",
            "description": "Function completes faster than expected, possibly skipping steps",
            "consequences": "May produce incomplete output or miss quality checks"
          },
          {
            "name": "Appropriate",
            "description": "Function takes the expected amount of time",
            "consequences": "Nominal operation with expected resource consumption"
          },
          {
            "name": "Too Long",
            "description": "Function takes longer than expected to complete",
            "consequences": "May delay downstream functions and consume extra resources"
          }
        ]
      },
      "sequence": {
        "description": "Whether the function is performed in the correct order relative to other functions",
        "phenotypes": [
          {
            "name": "Correct Order",
            "description": "Function is performed in the expected sequence position",
            "consequences": "Nominal operation with proper preconditions satisfied"
          },
          {
            "name": "Wrong Order",
            "description": "Function is performed out of expected sequence",
            "consequences": "May execute without proper preconditions or resources"
          },
          {
            "name": "Skipped",
            "description": "Function is omitted entirely from the sequence",
            "consequences": "Downstream functions miss required input or precondition"
          },
          {
            "name": "Repeated",
            "description": "Function is performed more than once when it should not be",
            "consequences": "May cause resource waste or conflicting outputs"
          }
        ]
      },
      "force": {
        "description": "The magnitude or intensity with which the function is performed",
        "phenotypes": [
          {
            "name": "Too Low",
            "description": "Function is performed with insufficient force or intensity",
            "consequences": "Output may be inadequate or below threshold requirements"
          },
          {
            "name": "On Target",
            "description": "Function is performed with the appropriate level of force or intensity",
            "consequences": "Nominal operation meeting specification requirements"
          },
          {
            "name": "Too High",
            "description": "Function is performed with excessive force or intensity",
            "consequences": "May cause damage, waste, or unintended side effects"
          }
        ]
      },
      "distance": {
        "description": "The spatial extent or reach of the function's effect",
        "phenotypes": [
          {
            "name": "Too Short",
            "description": "Function's effect does not reach the required distance or extent",
            "consequences": "Target may not be reached or affected sufficiently"
          },
          {
            "name": "Appropriate",
            "description": "Function's effect covers the expected spatial extent",
            "consequences": "Nominal operation with proper coverage"
          },
          {
            "name": "Too Long",
            "description": "Function's effect extends beyond the intended distance or extent",
            "consequences": "May affect unintended targets or cause interference"
          }
        ]
      },
      "direction": {
        "description": "Whether the function is directed toward the correct target or goal",
        "phenotypes": [
          {
            "name": "Correct",
            "description": "Function is directed toward the intended target",
            "consequences": "Nominal operation achieving the intended effect"
          },
          {
            "name": "Wrong",
            "description": "Function is directed toward an incorrect target",
            "consequences": "Intended target unaffected, unintended target may be affected"
          }
        ]
      }
    },
    "functionalResonanceConcepts": {
      "definition": "Functional resonance is the detectable signal that emerges from the \nunintended interaction of the variability of many functions. It occurs when the \nvariabilities of multiple functions combine in unexpected ways, potentially leading \nto disproportionately large (or small) consequences.",
      "characteristics": [
        "Emerges from normal performance variability, not from failures",
        "Cannot be predicted from individual function variabilities alone",
        "Can amplify or dampen variability",
        "Can lead to both positive and negative outcomes",
        "Depends on the timing and coincidence of variabilities"
      ],
      "analysisApproach": "To identify potential functional resonance:\n1. Identify functions with high variability potential\n2. Trace couplings and variability propagation paths\n3. Look for convergence points where multiple variable outputs combine\n4. Consider timing aspects - simultaneous variabilities may resonate\n5. Identify feedback loops that could amplify variability"
    }
  },
