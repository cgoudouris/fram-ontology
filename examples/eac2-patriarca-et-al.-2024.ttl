model:function_d302089a_b92a_456b_847c_22c96ed63703_qm a fram:QuantitativeMetadata ;
    fram:hasConstant [ a fram:Constant ;
        schema:name "DURATION" ;
        fram:value "4" ;
        fram:dataType "xsd:integer" ;
        fram:unit "time steps" ;
        rdfs:comment "Nominal duration for F07 (Article Table 1)" ;
        fram:semanticMeaning "Temporal measurement or constraint" ] ;
    fram:hasConstant [ a fram:Constant ;
        schema:name "DC2_COMBOS" ;
        fram:value "3" ;
        fram:dataType "xsd:integer" ;
        rdfs:comment "DC2(iii): 3 non-empty subsets from 2 outputs" ;
        fram:semanticMeaning "DC2(iii): 3 non-empty subsets from 2 outputs" ] ;
    fram:hasConstant [ a fram:Constant ;
        schema:name "DC2_MARGINAL_PROB" ;
        fram:value "0.6" ;
        fram:dataType "xsd:decimal" ;
        rdfs:comment "DC2 sensitivity (sigma-high): perturbed marginal prob = 0.600000" ;
        fram:semanticMeaning "DC2 sensitivity (sigma-high): perturbed marginal prob = 0.600000" ] ;
    fram:hasConstant [ a fram:Constant ;
        schema:name "NOMINAL_PRECISION" ;
        fram:value "1" ;
        fram:dataType "xsd:integer" ;
        rdfs:comment "Nominal precision for F07" ;
        fram:semanticMeaning "Nominal precision for F07" ] ;
    fram:hasConstant [ a fram:Constant ;
        schema:name "VISIT_PROB_NOMINAL" ;
        fram:value "0.09090909090909091" ;
        fram:dataType "xsd:decimal" ;
        rdfs:comment "p_0 = 4/42 (Article Sect 4.3.1)" ;
        fram:semanticMeaning "p_0 = 4/42 (Article Sect 4.3.1)" ] ;
    fram:hasVariable [ a fram:Variable ;
        schema:name "PERF_F07" ;
        fram:expression "(PERF_F02 || 1) * (PERF_F05 || 1) * (PERF_F06 || 1) * (PERF_F12 || 1) * NOMINAL_PRECISION" ;
        fram:codeType "expression" ;
        rdfs:comment "Precision propagation (Eq.19) for F07" ;
        fram:semanticMeaning "Precision propagation (Eq.19) for F07" ] ;
    fram:hasVariable [ a fram:Variable ;
        schema:name "_WALK_RAND" ;
        fram:expression "Math.random()" ;
        fram:codeType "expression" ;
        rdfs:comment "DC2 sensitivity (sigma-high): single random draw for combo selection" ;
        fram:semanticMeaning "DC2 sensitivity (sigma-high): single random draw for combo selection" ] ;
    fram:hasVariable [ a fram:Variable ;
        schema:name "_WALK_COMBO" ;
        fram:expression "_WALK_RAND < 0.285714 ? 1 : _WALK_RAND < 0.571429 ? 2 : 3" ;
        fram:codeType "expression" ;
        rdfs:comment "DC2 sensitivity (sigma-high): weighted combo via _WALK_RAND, p=0.6000 (base 0.6667, factor 1.2)" ;
        fram:semanticMeaning "DC2 sensitivity (sigma-high): weighted combo via _WALK_RAND, p=0.6000 (base 0.6667, factor 1.2)" ] ;
    fram:hasInterpretationProfile [ a fram:InterpretationProfile ;
        fram:input "ALL" ;
        fram:precondition "ALL" ;
        fram:resource "ALL" ;
        fram:time "ALL" ;
        fram:control "NONE" ;
        rdfs:comment "Defines how incoming aspects are interpreted for function activation" ] ;
    fram:isCustomActivation "false"^^xsd:boolean .

