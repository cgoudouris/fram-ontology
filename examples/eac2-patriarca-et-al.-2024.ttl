model:function_a2cb3d74_aa99_4017_87f3_de93349ba216_qm a fram:QuantitativeMetadata ;
    fram:hasConstant [ a fram:Constant ;
        schema:name "DURATION" ;
        fram:value "3" ;
        fram:dataType "xsd:integer" ;
        fram:unit "time steps" ;
        rdfs:comment "Nominal duration for F13 (Article Table 1)" ;
        fram:semanticMeaning "Temporal measurement or constraint" ] ;
    fram:hasConstant [ a fram:Constant ;
        schema:name "DC2_COMBOS" ;
        fram:value "3" ;
        fram:dataType "xsd:integer" ;
        rdfs:comment "DC2(iii): 3 non-empty subsets from 2 outputs" ;
        fram:semanticMeaning "DC2(iii): 3 non-empty subsets from 2 outputs" ] ;
    fram:hasConstant [ a fram:Constant ;
        schema:name "DC2_MARGINAL_PROB" ;
        fram:value "0.666667" ;
        fram:dataType "xsd:decimal" ;
        rdfs:comment "DC2(iii): marginal P(each output) = 2^(k-1)/(2^k-1)" ;
        fram:semanticMeaning "DC2(iii): marginal P(each output) = 2^(k-1)/(2^k-1)" ] ;
    fram:hasConstant [ a fram:Constant ;
        schema:name "NOMINAL_PRECISION" ;
        fram:value "1" ;
        fram:dataType "xsd:integer" ;
        rdfs:comment "Nominal precision for F13" ;
        fram:semanticMeaning "Nominal precision for F13" ] ;
    fram:hasConstant [ a fram:Constant ;
        schema:name "VISIT_PROB_NOMINAL" ;
        fram:value "0.06818181818181818" ;
        fram:dataType "xsd:decimal" ;
        rdfs:comment "p_0 = 3/42 (Article Sect 4.3.1)" ;
        fram:semanticMeaning "p_0 = 3/42 (Article Sect 4.3.1)" ] ;
    fram:hasVariable [ a fram:Variable ;
        schema:name "PERF_F13" ;
        fram:expression "(PERF_F03 || 1) * NOMINAL_PRECISION" ;
        fram:codeType "expression" ;
        rdfs:comment "Precision propagation (Eq.19) for F13" ;
        fram:semanticMeaning "Precision propagation (Eq.19) for F13" ] ;
    fram:hasVariable [ a fram:Variable ;
        schema:name "_WALK_COMBO" ;
        fram:expression "Math.floor(Math.random() * 3) + 1" ;
        fram:codeType "expression" ;
        rdfs:comment "DC2(iii) combination selector: int [1, 3]" ;
        fram:semanticMeaning "DC2(iii) combination selector: int [1, 3]" ] ;
    fram:hasInterpretationProfile [ a fram:InterpretationProfile ;
        fram:input "ALL" ;
        fram:precondition "NONE" ;
        fram:resource "NONE" ;
        fram:time "NONE" ;
        fram:control "NONE" ;
        rdfs:comment "Defines how incoming aspects are interpreted for function activation" ] ;
    fram:isCustomActivation "false"^^xsd:boolean .

