    fram:hasVariable [ a fram:Variable ;
        schema:name "OV_M15" ;
        fram:expression "((OV_M11 != null) ? OV_M11 * P_up_M11 : 0)" ;
        fram:codeType "expression" ;
        rdfs:comment "Total variability — transmitted only" ;
        fram:semanticMeaning "Total variability — transmitted only" ] ;
    fram:hasVariable [ a fram:Variable ;
        schema:name "P_up_M11" ;
        fram:expression "(OV_M11 != null) ? (1 - Math.exp(-Math.pow(OV_M11, 2))) : 0" ;
        fram:codeType "expression" ;
        rdfs:comment "Transmission probability from upstream M11 (Eq. 4)" ;
        fram:semanticMeaning "Transmission probability from upstream M11 (Eq. 4)" ] ;
    fram:hasInterpretationProfile [ a fram:InterpretationProfile ;
        fram:input "ANY" ;
