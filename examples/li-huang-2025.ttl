# =============================================================================
# METHODOLOGY CONTEXT
# =============================================================================

model:model_default fram:methodologyContext [
    a fram:FRAMPrinciple ;
    schema:name "Equivalence of Successes and Failures" ;
    rdfs:comment "Things that go right and things that go wrong happen in basically \nthe same way. Adverse outcomes (accidents, incidents) happen because something \ngoes wrong, i.e., because of malfunctions, failures, or errors. Things that go \nwell happen because the performance, or the functions, match the demands, \ni.e., because functions do what they are supposed to do."
] .

model:model_default fram:methodologyContext [
    a fram:FRAMPrinciple ;
    schema:name "Approximate Adjustments" ;
    rdfs:comment "People - and organisations - have to adjust what they do to match \nthe actual conditions, resources and demands. Since resources and time are finite, \nsuch adjustments will always be approximate. Because the adjustments are approximate, \nthey will also be variable - and this variability is essential for safety."
] .

model:model_default fram:methodologyContext [
    a fram:FRAMPrinciple ;
    schema:name "Emergence" ;
    rdfs:comment "Both wanted and unwanted outcomes are emergent phenomena, arising \nfrom the variability of everyday performance - also called normal performance \nvariability. The variability of multiple functions may combine in unexpected ways, \nleading to disproportionately large consequences. This is called functional resonance."
] .

model:model_default fram:methodologyContext [
    a fram:FRAMPrinciple ;
    schema:name "Functional Resonance" ;
    rdfs:comment "Functional resonance is defined as the detectable signal that emerges \nfrom the unintended interaction of the variability of many functions. Functional resonance \ncan lead to both positive and negative outcomes. The resonance is not caused by failures \nor malfunctions, but by the normal variability of functions."
] .

