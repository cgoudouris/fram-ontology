# LLM ANALYSIS PROMPTS
# =============================================================================

model:model_default fram:llmAnalysisPrompts [
    a fram:LLMPrompt ;
    schema:name "systemUnderstanding" ;
    schema:text "Analyze Li-Huang 2025 — HSR Risk-Accident Emergence (Ningbo-Wenzhou) to understand its purpose, scope, and key functions. \nIdentify the main activities represented, their relationships through the six FRAM aspects \n(Input, Output, Precondition, Resource, Control, Time), and describe how the system achieves its goals.\nConsider both Work-as-Done and Work-as-Imagined perspectives."
] .

model:model_default fram:llmAnalysisPrompts [
    a fram:LLMPrompt ;
    schema:name "variabilityAnalysis" ;
    schema:text "Examine each function in Li-Huang 2025 — HSR Risk-Accident Emergence (Ningbo-Wenzhou) for potential performance variability.\nConsider the Common Performance Conditions that might affect each function.\nIdentify which functions are most likely to exhibit timing variability (too early, on time, too late, not at all)\nand precision variability (precise, acceptable, imprecise).\nPay special attention to human functions which typically have higher variability."
] .

model:model_default fram:llmAnalysisPrompts [
    a fram:LLMPrompt ;
    schema:name "resonanceAnalysis" ;
    schema:text "Trace how variability might propagate through Li-Huang 2025 — HSR Risk-Accident Emergence (Ningbo-Wenzhou) via the couplings.\nIdentify convergence points where multiple variable outputs combine.\nLook for feedback loops that could amplify variability.\nDescribe potential functional resonance scenarios - both positive (leading to adaptation) \nand negative (leading to unwanted outcomes).\nFocus on functions with high connectivity as potential resonance points."
] .

model:model_default fram:llmAnalysisPrompts [
    a fram:LLMPrompt ;
    schema:name "improvementSuggestions" ;
    schema:text "Based on the analysis of Li-Huang 2025 — HSR Risk-Accident Emergence (Ningbo-Wenzhou), suggest improvements to:\n1. Reduce unwanted variability without eliminating beneficial flexibility\n2. Add buffers or barriers where tight coupling creates risk\n3. Improve monitoring and control of high-variability functions\n4. Enhance resources and preconditions for critical functions\n5. Address organizational factors that contribute to variability\nConsider Safety-II principles: focus on ensuring things go right, not just preventing things going wrong."
] .
