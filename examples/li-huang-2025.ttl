    fram:hasConstant [ a fram:Constant ;
        schema:name "DC_M1" ;
        fram:value "0.0000752" ;
        fram:dataType "xsd:decimal" ;
        rdfs:comment "Risk pulse energy — Machine and equipment failures" ;
        fram:semanticMeaning "Risk pulse energy — Machine and equipment failures" ] ;
    fram:hasVariable [ a fram:Variable ;
        schema:name "OV_M7" ;
        fram:expression "V_prime_M7" ;
        fram:codeType "expression" ;
        rdfs:comment "Total variability — no upstream transmission" ;
        fram:semanticMeaning "Total variability — no upstream transmission" ] ;
    fram:hasVariable [ a fram:Variable ;
        schema:name "V_prime_M7" ;
        fram:expression "Math.sqrt( (DC_M1 * DC_E) / (DC_M1 + DC_E) )" ;
        fram:codeType "expression" ;
        rdfs:comment "Self-variability from coupled risk factors DC_M1 and DC_E (Eq. 3, W=2)" ;
        fram:semanticMeaning "Self-variability from coupled risk factors DC_M1 and DC_E (Eq. 3, W=2)" ] ;
