model:function_d2092504_be37_42b8_8d4e_1c2026074253_qm a fram:QuantitativeMetadata ;
    fram:hasConstant [ a fram:Constant ;
        schema:name "DC_H" ;
        fram:value "0.000069" ;
        fram:dataType "xsd:decimal" ;
        rdfs:comment "Risk pulse energy — Human risk factors (annual casualties)" ;
        fram:semanticMeaning "Risk pulse energy — Human risk factors (annual casualties)" ] ;
    fram:hasConstant [ a fram:Constant ;
        schema:name "DC_M2" ;
        fram:value "0.000013" ;
        fram:dataType "xsd:decimal" ;
        rdfs:comment "Risk pulse energy — Management failures" ;
        fram:semanticMeaning "Risk pulse energy — Management failures" ] ;
    fram:hasVariable [ a fram:Variable ;
        schema:name "OV_M11" ;
        fram:expression "V_prime_M11 + V_transmitted_M11" ;
        fram:codeType "expression" ;
        rdfs:comment "Total variability (self + transmitted) (Eq. 6)" ;
        fram:semanticMeaning "Total variability (self + transmitted) (Eq. 6)" ] ;
    fram:hasVariable [ a fram:Variable ;
        schema:name "P_up_M5" ;
        fram:expression "(OV_M5 != null) ? (1 - Math.exp(-Math.pow(OV_M5, 2))) : 0" ;
        fram:codeType "expression" ;
        rdfs:comment "Transmission probability from upstream M5 (Eq. 4)" ;
        fram:semanticMeaning "Transmission probability from upstream M5 (Eq. 4)" ] ;
    fram:hasVariable [ a fram:Variable ;
        schema:name "V_prime_M11" ;
        fram:expression "Math.sqrt( (DC_H * DC_M2) / (DC_H + DC_M2) )" ;
        fram:codeType "expression" ;
        rdfs:comment "Self-variability from coupled risk factors DC_H and DC_M2 (Eq. 3, W=2)" ;
        fram:semanticMeaning "Self-variability from coupled risk factors DC_H and DC_M2 (Eq. 3, W=2)" ] ;
    fram:hasVariable [ a fram:Variable ;
        schema:name "V_transmitted_M11" ;
        fram:expression "((OV_M5 != null) ? OV_M5 * P_up_M5 : 0)" ;
        fram:codeType "expression" ;
        rdfs:comment "Variability received from upstream (Eq. 5)" ;
        fram:semanticMeaning "Variability received from upstream (Eq. 5)" ] ;
    fram:hasInterpretationProfile [ a fram:InterpretationProfile ;
        fram:input "ANY" ;
        fram:precondition "ANY" ;
        fram:resource "NONE" ;
        fram:time "NONE" ;
        fram:control "ANY" ;
        rdfs:comment "Defines how incoming aspects are interpreted for function activation" ] ;
    fram:isCustomActivation "true"^^xsd:boolean .

