    schema:version "1.0" .

<https://flowfram.com/models/aspect_control_0328367d_3e6d_44a9_9c78_ecdbf22a1043> a ns1:ControlAspect ;
    rdfs:comment """Control (C) is how the function is monitored, supervised, or 
regulated so that it can adjust to produce the required Output. Control represents 
the regulation or governance of the function.
Examples: Procedures, guidelines, supervisory oversight, feedback loops, 
monitoring systems, regulations.""" ;
    ns1:aspectCode "C" ;
    ns1:aspectType "Control" ;
    ns1:hasCoupling <https://flowfram.com/models/coupling_061863cc_9c5a_4137_b0e6_090a880726d2> ;
