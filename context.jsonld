{
  "@context": {
    "@version": 1.1,
    "fram": "https://flowfram.com/ontology/fram/",
    "schema": "https://schema.org/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "dc": "http://purl.org/dc/elements/1.1/",
    "dcterms": "http://purl.org/dc/terms/",

    "id": "@id",
    "type": "@type",
    "label": "rdfs:label",
    "description": "rdfs:comment",
    "name": "schema:name",
    "definition": "skos:definition",
    "note": "skos:note",
    "example": "skos:example",

    "FRAMModel": "fram:FRAMModel",
    "Function": "fram:Function",
    "Aspect": "fram:Aspect",
    "Coupling": "fram:Coupling",
    "Variability": "fram:Variability",
    "PerformanceCondition": "fram:PerformanceCondition",
    "FunctionalResonance": "fram:FunctionalResonance",
    "VariabilityPhenotype": "fram:VariabilityPhenotype",

    "HumanFunction": "fram:HumanFunction",
    "TechnologicalFunction": "fram:TechnologicalFunction",
    "OrganisationalFunction": "fram:OrganisationalFunction",
    "BackgroundFunction": "fram:BackgroundFunction",
    "EntryFunction": "fram:EntryFunction",
    "ExitFunction": "fram:ExitFunction",

    "InputAspect": "fram:InputAspect",
    "OutputAspect": "fram:OutputAspect",
    "PreconditionAspect": "fram:PreconditionAspect",
    "ResourceAspect": "fram:ResourceAspect",
    "ControlAspect": "fram:ControlAspect",
    "TimeAspect": "fram:TimeAspect",

    "InternalVariability": "fram:InternalVariability",
    "ExternalVariability": "fram:ExternalVariability",
    "UpstreamVariability": "fram:UpstreamVariability",
    "DownstreamVariability": "fram:DownstreamVariability",

    "Distribution": "fram:Distribution",
    "NormalDistribution": "fram:NormalDistribution",
    "UniformDistribution": "fram:UniformDistribution",
    "TriangularDistribution": "fram:TriangularDistribution",
    "LogNormalDistribution": "fram:LogNormalDistribution",

    "Phenotype": "fram:Phenotype",
    "TimingPhenotypeClass": "fram:TimingPhenotype",
    "PrecisionPhenotypeClass": "fram:PrecisionPhenotype",

    "TooEarly": "fram:TooEarly",
    "OnTime": "fram:OnTime",
    "TooLate": "fram:TooLate",
    "NotAtAll": "fram:NotAtAll",
    "Precise": "fram:Precise",
    "Acceptable": "fram:Acceptable",
    "Imprecise": "fram:Imprecise",

    "hasFunction": { "@id": "fram:hasFunction", "@type": "@id" },
    "hasCoupling": { "@id": "fram:hasCoupling", "@type": "@id" },
    "hasAspect": { "@id": "fram:hasAspect", "@type": "@id" },
    "hasVariability": { "@id": "fram:hasVariability", "@type": "@id" },
    "hasPerformanceCondition": { "@id": "fram:hasPerformanceCondition", "@type": "@id" },
    "sourceFunction": { "@id": "fram:sourceFunction", "@type": "@id" },
    "targetFunction": { "@id": "fram:targetFunction", "@type": "@id" },
    "sourceAspect": { "@id": "fram:sourceAspect", "@type": "@id" },
    "targetAspect": { "@id": "fram:targetAspect", "@type": "@id" },
    "hasDistribution": { "@id": "fram:hasDistribution", "@type": "@id" },
    "hasPhenotype": { "@id": "fram:hasPhenotype", "@type": "@id" },
    "hasContributingFactor": { "@id": "fram:hasContributingFactor", "@type": "@id" },
    "hasConstant": { "@id": "fram:hasConstant", "@type": "@id" },
    "hasVariable": { "@id": "fram:hasVariable", "@type": "@id" },
    "hasOutput": { "@id": "fram:hasOutput", "@type": "@id" },
    "originChain": { "@id": "fram:originChain", "@type": "@id" },
    "resonancePoint": { "@id": "fram:resonancePoint", "@type": "@id" },
    "criticalPath": { "@id": "fram:criticalPath", "@type": "@id" },
    "variabilityHotspot": { "@id": "fram:variabilityHotspot", "@type": "@id" },

    "couplingStrength": { "@id": "fram:couplingStrength", "@type": "xsd:decimal" },
    "resonanceFactor": { "@id": "fram:resonanceFactor", "@type": "xsd:decimal" },
    "phenotypeProbability": { "@id": "fram:phenotypeProbability", "@type": "xsd:decimal" },
    "distributionMean": { "@id": "fram:distributionMean", "@type": "xsd:decimal" },
    "distributionStdDev": { "@id": "fram:distributionStdDev", "@type": "xsd:decimal" },
    "distributionMin": { "@id": "fram:distributionMin", "@type": "xsd:decimal" },
    "distributionMax": { "@id": "fram:distributionMax", "@type": "xsd:decimal" },

    "aspectType": "fram:aspectType",
    "aspectCode": "fram:aspectCode",
    "functionType": "fram:functionType",
    "variabilityPotential": "fram:variabilityPotential",
    "timingPhenotype": "fram:timingPhenotype",
    "precisionPhenotype": "fram:precisionPhenotype",
    "phenotypeValue": "fram:phenotypeValue",
    "unit": "fram:unit",
    "expression": "fram:expression",
    "dataType": "fram:dataType",
    "formula": "fram:formula",
    "instantiationId": "fram:instantiationId",
    "analysisType": "fram:analysisType",
    "analysisScope": "fram:analysisScope",
    "analysisFocus": "fram:analysisFocus",

    "executionTimestamp": { "@id": "fram:executionTimestamp", "@type": "xsd:dateTime" },
    "cycleNumber": { "@id": "fram:cycleNumber", "@type": "xsd:integer" },

    "creator": "schema:creator",
    "author": "schema:author",
    "dateCreated": "schema:dateCreated",
    "dateModified": "schema:dateModified",
    "version": "schema:version",
    "about": "schema:about",
    "keywords": "schema:keywords",
    "isPartOf": { "@id": "schema:isPartOf", "@type": "@id" },
    "hasPart": { "@id": "schema:hasPart", "@type": "@id" }
  }
}
