fram:isResonancePointIn a owl:ObjectProperty ;
    rdfs:label "is resonance point in"@en ;
    rdfs:comment "Relates a function to the functional resonance where it is a resonance point."@en ;
    rdfs:domain fram:Function ;
    rdfs:range fram:FunctionalResonance ;
    owl:inverseOf fram:resonancePoint ;
