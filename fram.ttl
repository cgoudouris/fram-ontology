    rdfs:domain fram:Phenotype ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .


# =============================================================================
# P04 FIX: CONNECT UNCONNECTED ONTOLOGY ELEMENTS (v1.1.0)
# =============================================================================

fram:hasInterpretationProfile a owl:ObjectProperty ;
    rdfs:label "has interpretation profile"@en ;
    rdfs:comment "Relates a function to its interpretation profile defining how incoming aspects are combined."@en ;
    rdfs:domain fram:Function ;
    rdfs:range fram:InterpretationProfile ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

fram:hasPassthrough a owl:ObjectProperty ;
    rdfs:label "has passthrough"@en ;
    rdfs:comment "Relates an output message to a passthrough field forwarded without transformation."@en ;
    rdfs:domain fram:OutputMessage ;
    rdfs:range fram:Passthrough ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .


# =============================================================================
# P10 FIX: DISJOINTNESS AXIOMS (v1.1.0)
# =============================================================================

[] a owl:AllDisjointClasses ;
   owl:members (
        fram:HumanFunction
        fram:TechnologicalFunction
        fram:OrganisationalFunction
        fram:BackgroundFunction
        fram:EntryFunction
        fram:ExitFunction
    ) .

[] a owl:AllDisjointClasses ;
   owl:members (
        fram:InputAspect
        fram:OutputAspect
        fram:PreconditionAspect
        fram:ResourceAspect
        fram:ControlAspect
        fram:TimeAspect
    ) .

[] a owl:AllDisjointClasses ;
   owl:members (
        fram:TimingPhenotype
        fram:PrecisionPhenotype
    ) .

[] a owl:AllDisjointClasses ;
   owl:members (
        fram:NormalDistribution
        fram:UniformDistribution
        fram:TriangularDistribution
        fram:LogNormalDistribution
    ) .

[] a owl:AllDisjointClasses ;
   owl:members (
        fram:UpstreamVariability
        fram:DownstreamVariability
        fram:InternalVariability
        fram:ExternalVariability
    ) .


# =============================================================================
# P13 FIX: INVERSE RELATIONSHIPS (v1.1.0)
# =============================================================================

fram:isFunctionOf a owl:ObjectProperty ;
    rdfs:label "is function of"@en ;
    rdfs:comment "Relates a function back to its parent FRAM model."@en ;
    rdfs:domain fram:Function ;
    rdfs:range fram:FRAMModel ;
    owl:inverseOf fram:hasFunction ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

fram:isCouplingOf a owl:ObjectProperty ;
    rdfs:label "is coupling of"@en ;
    rdfs:comment "Relates a coupling back to its parent FRAM model."@en ;
    rdfs:domain fram:Coupling ;
    rdfs:range fram:FRAMModel ;
    owl:inverseOf fram:hasCoupling ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

fram:isAspectOf a owl:ObjectProperty ;
    rdfs:label "is aspect of"@en ;
    rdfs:comment "Relates an aspect back to its parent function."@en ;
    rdfs:domain fram:Aspect ;
    rdfs:range fram:Function ;
    owl:inverseOf fram:hasAspect ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

fram:isSourceOf a owl:ObjectProperty ;
    rdfs:label "is source of"@en ;
    rdfs:comment "Relates a function to couplings where it is the source."@en ;
    rdfs:domain fram:Function ;
    rdfs:range fram:Coupling ;
    owl:inverseOf fram:sourceFunction ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

fram:isTargetOf a owl:ObjectProperty ;
    rdfs:label "is target of"@en ;
    rdfs:comment "Relates a function to couplings where it is the target."@en ;
    rdfs:domain fram:Function ;
    rdfs:range fram:Coupling ;
    owl:inverseOf fram:targetFunction ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

