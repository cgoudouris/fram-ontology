fram:isConstantOf a owl:ObjectProperty ;
    rdfs:label "is constant of"@en ;
    rdfs:comment "Relates a constant back to its parent function."@en ;
    rdfs:domain fram:Constant ;
    rdfs:range fram:Function ;
    owl:inverseOf fram:hasConstant ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

fram:isVariableOf a owl:ObjectProperty ;
    rdfs:label "is variable of"@en ;
    rdfs:comment "Relates a variable back to its parent function."@en ;
    rdfs:domain fram:Variable ;
    rdfs:range fram:Function ;
    owl:inverseOf fram:hasVariable ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

fram:isOutputOf a owl:ObjectProperty ;
    rdfs:label "is output of"@en ;
    rdfs:comment "Relates an output message back to its parent function."@en ;
    rdfs:domain fram:OutputMessage ;
    rdfs:range fram:Function ;
    owl:inverseOf fram:hasOutput ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

fram:isScenarioOf a owl:ObjectProperty ;
    rdfs:label "is scenario of"@en ;
    rdfs:comment "Relates a scenario back to its parent FRAM model."@en ;
    rdfs:domain fram:FRAMScenario ;
    rdfs:range fram:FRAMModel ;
    owl:inverseOf fram:hasScenario ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

fram:isInterpretationProfileOf a owl:ObjectProperty ;
    rdfs:label "is interpretation profile of"@en ;
    rdfs:comment "Relates an interpretation profile back to its parent function."@en ;
    rdfs:domain fram:InterpretationProfile ;
    rdfs:range fram:Function ;
    owl:inverseOf fram:hasInterpretationProfile ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

fram:isPassthroughOf a owl:ObjectProperty ;
    rdfs:label "is passthrough of"@en ;
    rdfs:comment "Relates a passthrough field back to its parent output message."@en ;
    rdfs:domain fram:Passthrough ;
    rdfs:range fram:OutputMessage ;
    owl:inverseOf fram:hasPassthrough ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

fram:isOriginChainIn a owl:ObjectProperty ;
    rdfs:label "is origin chain in"@en ;
    rdfs:comment "Relates a function to the functional resonance where it appears in the origin chain."@en ;
    rdfs:domain fram:Function ;
    rdfs:range fram:FunctionalResonance ;
    owl:inverseOf fram:originChain ;
