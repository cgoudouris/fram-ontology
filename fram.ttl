# =============================================================================
# FOUNDATIONAL ONTOLOGY ALIGNMENT (gUFO — Guizzardi et al., 2021)
# =============================================================================
#
# Lightweight alignment with the Unified Foundational Ontology (UFO) via its
# OWL implementation gUFO (https://purl.org/nemo/gufo). This alignment anchors
# FRAM domain concepts in well-established ontological categories, improving
# semantic interoperability and conceptual clarity.
#
# Design decisions:
#
# 1. Function → gufo:Event (not gufo:Disposition).
#    Lališ et al. (2019) proposed mapping FRAM Functions to UFO Dispositions
#    (latent properties that manifest through events). We diverge: a FRAM
#    Function, as defined by Hollnagel (2012, p. 37), is "what people —
#    individually or collectively — have to do or what has to take place",
#    i.e., the activity itself (an Event), not the latent capacity to perform
#    it. The Disposition mapping is reused for PerformanceCondition (CPC),
#    which genuinely represents latent properties that influence variability.
#
# 2. HumanFunction → gufo:Event (intentional event with agent).
#    Non-human function types remain as gufo:Event (non-intentional).
#    Function subtypes are organized in two orthogonal dimensions:
#    Nature (Human/Tech/Org) and FlowRole (Entry/Exit/Background/Foreground).
#
# 3. Coupling → gufo:RelationalQuality.
#    Couplings are first-class entities that mediate the relationship between
#    two functions. In gUFO, RelationalQuality captures existentially
#    dependent relations that inhere in their relata.
#
# 4. rdfs:subClassOf (not owl:equivalentClass).
#    The alignment is specialization, not equivalence: every FRAM Function
#    is an Event, but not every Event is a FRAM Function. This preserves
#    the Open World Assumption.
#
# 5. No owl:imports of gUFO.
#    The alignment is lightweight — only subsumption axioms — to avoid
#    importing ~500 gUFO classes into the FRAM graph. Full import is
#    available for users who need complete UFO reasoning.
#
# References:
#   Guizzardi, G. (2005). Ontological Foundations for Structural Conceptual
#     Models. PhD Thesis, University of Twente.
#   Guizzardi, G. et al. (2021). gUFO: A Lightweight Implementation of the
#     Unified Foundational Ontology. Applied Ontology, 17(1), 105-150.
#   Lališ, A. et al. (2019). Foundational ontological analysis of the FRAM.
#     Safety Science, 117, 291-305.
# =============================================================================

# --- External gUFO class declarations ---
# Declared as owl:Class with rdfs:label to satisfy OOPS! pitfall scanners
# P34 (untyped class) and P08 (missing annotations). The authoritative
# definitions reside in the gUFO ontology (<http://purl.org/nemo/gufo#>).

gufo:Object a owl:Class ;
    rdfs:label "Object"@en ;
    rdfs:comment "An endurant that persists through time. Defined in gUFO (Guizzardi et al., 2021)."@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo#> .

gufo:Event a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "A perdurant — an occurrence that unfolds in time. Defined in gUFO (Guizzardi et al., 2021)."@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo#> .

gufo:IntrinsicMode a owl:Class ;
    rdfs:label "Intrinsic Mode"@en ;
    rdfs:comment "A moment (property particular) that inheres in a single individual. Defined in gUFO (Guizzardi et al., 2021)."@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo#> .

gufo:RelationalQuality a owl:Class ;
    rdfs:label "Relational Quality"@en ;
    rdfs:comment "An externally dependent property that inheres in two or more individuals. Defined in gUFO (Guizzardi et al., 2021)."@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo#> .

gufo:Quality a owl:Class ;
    rdfs:label "Quality"@en ;
    rdfs:comment "A measurable intrinsic property with an associated quality space. Defined in gUFO (Guizzardi et al., 2021)."@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo#> .

gufo:Disposition a owl:Class ;
    rdfs:label "Disposition"@en ;
    rdfs:comment "A latent property that manifests under specific conditions. Defined in gUFO (Guizzardi et al., 2021)."@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo#> .

gufo:AbstractIndividual a owl:Class ;
    rdfs:label "Abstract Individual"@en ;
    rdfs:comment "An entity that does not exist in space-time. Defined in gUFO (Guizzardi et al., 2021)."@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo#> .

gufo:QualityValue a owl:Class ;
    rdfs:label "Quality Value"@en ;
    rdfs:comment "A point in the quality space of a quality. Defined in gUFO (Guizzardi et al., 2021)."@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo#> .

# --- Core class alignments ---

fram:FRAMModel rdfs:subClassOf gufo:Object ;
    rdfs:comment "A FRAM Model is a gufo:Object — an endurant that persists through time and aggregates functions, aspects, and couplings as a structured whole."@en .

fram:Function rdfs:subClassOf gufo:Event ;
    rdfs:comment "A FRAM Function is a gufo:Event — an occurrence that unfolds in time. This diverges from Lališ et al. (2019), who proposed Disposition; see design decision #1 above."@en .

fram:HumanFunction rdfs:subClassOf gufo:Event .
    # Note: gUFO does not distinguish Action from Event at the class level;
    # intentionality is captured via participation relations. HumanFunction
    # inherits gufo:Event via fram:Function.

fram:Aspect rdfs:subClassOf gufo:IntrinsicMode ;
    rdfs:comment "A FRAM Aspect is a gufo:IntrinsicMode — a moment (property particular) that inheres in a single Function and characterizes one of its six facets."@en .

fram:Coupling rdfs:subClassOf gufo:RelationalQuality ;
    rdfs:comment "A FRAM Coupling is a gufo:RelationalQuality — an externally dependent property that inheres in (and existentially depends on) two Functions simultaneously."@en .

fram:Variability rdfs:subClassOf gufo:Quality ;
    rdfs:comment "Variability is a gufo:Quality — a measurable intrinsic property of a Function's output, with a multi-dimensional quality space (timing × duration × sequence × precision × ...)."@en .

fram:VariabilityDimension rdfs:subClassOf gufo:Quality ;
    rdfs:comment "A VariabilityDimension is a gufo:Quality — a named dimension of the variability quality space along which phenotype values are defined."@en .

fram:PerformanceCondition rdfs:subClassOf gufo:Disposition ;
    rdfs:comment "A CPC is a gufo:Disposition — a latent property that manifests under specific conditions, influencing the variability of function outputs. This adopts the Disposition mapping from Lališ et al. (2019), applied here to CPCs rather than Functions."@en .

fram:FunctionalResonance rdfs:subClassOf gufo:Event ;
    rdfs:comment "Functional Resonance is a gufo:Event — an emergent complex event arising from the temporal coincidence and mutual amplification of everyday variability across coupled functions."@en .

fram:Distribution rdfs:subClassOf gufo:AbstractIndividual ;
    rdfs:comment "A probability distribution is a gufo:AbstractIndividual — an abstract entity that does not exist in space-time but characterizes the quantitative profile of variability."@en .

fram:Phenotype rdfs:subClassOf gufo:QualityValue ;
    rdfs:comment "A phenotype is a gufo:QualityValue — a point in a specific dimension of the variability quality space (e.g., OnTime in TimingDimension, TooLow in ForceDimension)."@en .

fram:FRAMScenario rdfs:subClassOf gufo:Object ;
    rdfs:comment "A FRAM Scenario is a gufo:Object — a persistent configuration of parameter values for comparative analysis."@en .

# ============================================================================
# EMERGENT PHENOTYPE CLASSIFICATION & WAI/WAD ANALYSIS (v1.6.0)
# ============================================================================
# These classes support the emergent phenotype classification proposal:
# analyst-defined interpretation rules map metadata values to phenotype
# categories, enabling Work-as-Imagined vs. Work-as-Done comparison.
# See: docs/proposals/EMERGENT-PHENOTYPE-WAI-WAD-PROPOSAL.md
# ============================================================================

fram:PhenotypeMappingRule a owl:Class ;
    rdfs:subClassOf gufo:AbstractIndividual ;
    rdfs:label "Phenotype Mapping Rule"@en ;
    rdfs:comment "A rule that maps a metadata variable to phenotype classifications along a variability dimension, using threshold conditions to classify emergent values. PhenotypeMappingRules are abstract specifications that exist independently of any particular instantiation."@en ;
    skos:definition "An analyst-defined classification rule that associates a computed metadata variable (e.g., RESPONSE_TIME) with a VariabilityDimension (e.g., TimingDimension) and specifies threshold conditions for each phenotype category (e.g., value < 0.7 → TooEarly, value >= 0.7 && value <= 1.3 → OnTime)."@en ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

fram:WAIDeclaration a owl:Class ;
    rdfs:subClassOf gufo:AbstractIndividual ;
    rdfs:label "Work-as-Imagined Declaration"@en ;
    rdfs:comment "An analyst's expectation about the dominant phenotype of a function along a specific variability dimension, prior to model instantiation. Represents the prescriptive aspect of FRAM Step 2 (Hollnagel, 2012), explicitly requalified as Work-as-Imagined."@en ;
    skos:definition "A formal declaration of the analyst's expected dominant phenotype for a function's output, annotated with confidence level and rationale. WAI declarations are compared against emergent WAD results to quantify the gap between expectation and reality."@en ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

fram:EmergentPhenotypeResult a owl:Class ;
    rdfs:subClassOf gufo:Event ;
    rdfs:label "Emergent Phenotype Result"@en ;
    rdfs:comment "The observed phenotype distribution computed from simulation results by applying a PhenotypeMappingRule. Represents Work-as-Done — the actual emergent behavior classified according to the analyst's interpretation rules."@en ;
    skos:definition "A probability distribution over phenotype categories for a specific function and variability dimension, computed by classifying each simulation iteration's output value according to a PhenotypeMappingRule. The dominant phenotype is the most frequently observed category."@en ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

fram:WAIWADComparison a owl:Class ;
    rdfs:subClassOf gufo:AbstractIndividual ;
    rdfs:label "WAI/WAD Comparison"@en ;
    rdfs:comment "A structured comparison between the analyst's expectation (WAI) and the emergent simulation result (WAD), including the quantitative discordance index Δ(WAI-WAD)."@en ;
    skos:definition "A comparison artifact that pairs a WAIDeclaration with an EmergentPhenotypeResult for the same function and dimension, computing a discordance index Δ = 1 - P_WAD(c_WAI) where c_WAI is the expected phenotype category and P_WAD(c_WAI) is its observed probability."@en ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

# --- Object Properties for Emergent Phenotype Classification ---

fram:hasPhenotypeMappingRule a owl:ObjectProperty ;
    rdfs:label "has phenotype mapping rule"@en ;
    rdfs:comment "Associates a Function with analyst-defined rules for classifying its output into phenotype categories."@en ;
    rdfs:domain fram:Function ;
    rdfs:range fram:PhenotypeMappingRule .

fram:hasWAIDeclaration a owl:ObjectProperty ;
    rdfs:label "has WAI declaration"@en ;
    rdfs:comment "Associates a PhenotypeMappingRule with the analyst's expected (Work-as-Imagined) phenotype."@en ;
    rdfs:domain fram:PhenotypeMappingRule ;
    rdfs:range fram:WAIDeclaration .

fram:hasEmergentResult a owl:ObjectProperty ;
    rdfs:label "has emergent result"@en ;
    rdfs:comment "Associates a PhenotypeMappingRule with its computed emergent phenotype distribution (Work-as-Done)."@en ;
    rdfs:domain fram:PhenotypeMappingRule ;
    rdfs:range fram:EmergentPhenotypeResult .

fram:hasWAIWADComparison a owl:ObjectProperty ;
    rdfs:label "has WAI/WAD comparison"@en ;
    rdfs:comment "Associates a Function with the structured comparison between expected and emergent phenotypes."@en ;
    rdfs:domain fram:Function ;
    rdfs:range fram:WAIWADComparison .

fram:mapsToVariable a owl:DatatypeProperty ;
    rdfs:label "maps to variable"@en ;
    rdfs:comment "The metadata variable or expression whose values are classified by this mapping rule."@en ;
    rdfs:domain fram:PhenotypeMappingRule ;
    rdfs:range xsd:string .

fram:mapsToDimension a owl:ObjectProperty ;
    rdfs:label "maps to dimension"@en ;
    rdfs:comment "The variability dimension along which phenotype classification is performed."@en ;
    rdfs:domain fram:PhenotypeMappingRule ;
    rdfs:range fram:VariabilityDimension .

# --- Datatype Properties for WAI/WAD Analysis ---

fram:discordanceIndex a owl:DatatypeProperty ;
    rdfs:label "discordance index"@en ;
    rdfs:comment "Quantitative measure of the gap between WAI and WAD: Δ = 1 - P_WAD(WAI_category). Range [0, 1]. Δ = 0 means perfect concordance; Δ = 1 means complete discordance."@en ;
    rdfs:domain fram:WAIWADComparison ;
    rdfs:range xsd:decimal .

fram:concordanceLevel a owl:DatatypeProperty ;
    rdfs:label "concordance level"@en ;
    rdfs:comment "Qualitative concordance classification: full (Δ ≤ 0.20), partial (0.20 < Δ ≤ 0.50), discordant (Δ > 0.50)."@en ;
    rdfs:domain fram:WAIWADComparison ;
    rdfs:range xsd:string .

fram:waiConfidence a owl:DatatypeProperty ;
    rdfs:label "WAI confidence"@en ;
    rdfs:comment "Analyst's self-assessed confidence in the WAI declaration: Low, Medium, High."@en ;
    rdfs:domain fram:WAIDeclaration ;
    rdfs:range xsd:string .

fram:waiRationale a owl:DatatypeProperty ;
    rdfs:label "WAI rationale"@en ;
    rdfs:comment "Free-text justification for the analyst's WAI expectation."@en ;
    rdfs:domain fram:WAIDeclaration ;
    rdfs:range xsd:string .

fram:dominantPhenotype a owl:DatatypeProperty ;
    rdfs:label "dominant phenotype"@en ;
    rdfs:comment "The phenotype category with the highest observed probability in the emergent result distribution."@en ;
    rdfs:domain fram:EmergentPhenotypeResult ;
    rdfs:range xsd:string .

fram:dominantProbability a owl:DatatypeProperty ;
    rdfs:label "dominant probability"@en ;
    rdfs:comment "The probability of the dominant phenotype in the emergent result distribution."@en ;
    rdfs:domain fram:EmergentPhenotypeResult ;
    rdfs:range xsd:decimal .

fram:sampleSize a owl:DatatypeProperty ;
    rdfs:label "sample size"@en ;
    rdfs:comment "Number of simulation iterations classified to produce the emergent phenotype distribution."@en ;
    rdfs:domain fram:EmergentPhenotypeResult ;
    rdfs:range xsd:integer .

# --- Semantic Purity: OutputMessage and InterpretationProfile properties (v1.7.0) ---

fram:targetAspectType a owl:DatatypeProperty ;
    rdfs:label "target aspect type"@en ;
    rdfs:comment "The type of aspect (e.g. input, control, precondition, resource, time) on the target function that an output message connects to."@en ;
    rdfs:domain fram:OutputMessage ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

fram:input a owl:DatatypeProperty ;
    rdfs:label "input aspect interpretation"@en ;
    rdfs:comment "The interpretation mode for the Input aspect in an InterpretationProfile (e.g. ANY, NONE, ALL)."@en ;
    rdfs:domain fram:InterpretationProfile ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

fram:precondition a owl:DatatypeProperty ;
    rdfs:label "precondition aspect interpretation"@en ;
    rdfs:comment "The interpretation mode for the Precondition aspect in an InterpretationProfile (e.g. ANY, NONE, ALL)."@en ;
    rdfs:domain fram:InterpretationProfile ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

fram:resource a owl:DatatypeProperty ;
    rdfs:label "resource aspect interpretation"@en ;
    rdfs:comment "The interpretation mode for the Resource aspect in an InterpretationProfile (e.g. ANY, NONE, ALL)."@en ;
    rdfs:domain fram:InterpretationProfile ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

fram:control a owl:DatatypeProperty ;
    rdfs:label "control aspect interpretation"@en ;
    rdfs:comment "The interpretation mode for the Control aspect in an InterpretationProfile (e.g. ANY, NONE, ALL)."@en ;
    rdfs:domain fram:InterpretationProfile ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

fram:time a owl:DatatypeProperty ;
    rdfs:label "time aspect interpretation"@en ;
    rdfs:comment "The interpretation mode for the Time aspect in an InterpretationProfile (e.g. ANY, NONE, ALL)."@en ;
    rdfs:domain fram:InterpretationProfile ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://flowfram.com/ontology/fram/> .

# --- Inverse Properties for Emergent Phenotype Classification ---

fram:isPhenotypeMappingRuleOf a owl:ObjectProperty ;
    rdfs:label "is phenotype mapping rule of"@en ;
    rdfs:comment "Inverse of hasPhenotypeMappingRule: links a PhenotypeMappingRule back to its Function."@en ;
    owl:inverseOf fram:hasPhenotypeMappingRule ;
    rdfs:domain fram:PhenotypeMappingRule ;
    rdfs:range fram:Function .

fram:isWAIDeclarationOf a owl:ObjectProperty ;
    rdfs:label "is WAI declaration of"@en ;
    rdfs:comment "Inverse of hasWAIDeclaration: links a WAIDeclaration back to its PhenotypeMappingRule."@en ;
    owl:inverseOf fram:hasWAIDeclaration ;
    rdfs:domain fram:WAIDeclaration ;
    rdfs:range fram:PhenotypeMappingRule .

fram:isEmergentResultOf a owl:ObjectProperty ;
    rdfs:label "is emergent result of"@en ;
    rdfs:comment "Inverse of hasEmergentResult: links an EmergentPhenotypeResult back to its PhenotypeMappingRule."@en ;
    owl:inverseOf fram:hasEmergentResult ;
    rdfs:domain fram:EmergentPhenotypeResult ;
    rdfs:range fram:PhenotypeMappingRule .

fram:isWAIWADComparisonOf a owl:ObjectProperty ;
    rdfs:label "is WAI/WAD comparison of"@en ;
    rdfs:comment "Inverse of hasWAIWADComparison: links a WAIWADComparison back to its Function."@en ;
    owl:inverseOf fram:hasWAIWADComparison ;
    rdfs:domain fram:WAIWADComparison ;
    rdfs:range fram:Function .

fram:isMappingDimensionOf a owl:ObjectProperty ;
    rdfs:label "is mapping dimension of"@en ;
    rdfs:comment "Inverse of mapsToDimension: links a VariabilityDimension back to PhenotypeMappingRules that classify along it."@en ;
    owl:inverseOf fram:mapsToDimension ;
    rdfs:domain fram:VariabilityDimension ;
    rdfs:range fram:PhenotypeMappingRule .
