  <rdf:Description rdf:about="https://flowfram.com/ontology/fram/waiConfidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">WAI confidence</rdfs:label>
    <rdfs:comment xml:lang="en">Analyst's self-assessed confidence in the WAI declaration: Low, Medium, High.</rdfs:comment>
    <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/WAIDeclaration"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
