  <owl:Class rdf:about="https://flowfram.com/ontology/fram/FRAMPrinciple">
    <rdfs:label xml:lang="en">FRAM Principle</rdfs:label>
    <rdfs:comment xml:lang="en">A core principle of the FRAM methodology.</rdfs:comment>
    <skos:definition xml:lang="en">Represents one of the foundational principles of the Functional Resonance Analysis Method as defined by Hollnagel.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://flowfram.com/ontology/fram/isVariabilityOf">
    <rdfs:label xml:lang="en">is variability of</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a variability characterization back to its function.</rdfs:comment>
    <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Variability"/>
    <rdfs:range rdf:resource="https://flowfram.com/ontology/fram/Function"/>
