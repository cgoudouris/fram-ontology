        <rdfs:range rdf:resource="https://flowfram.com/ontology/fram/Constant"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
  </owl:ObjectProperty>
