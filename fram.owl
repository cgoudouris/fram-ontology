    <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Function"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://flowfram.com/ontology/fram/isOriginChainIn">
    <rdfs:label xml:lang="en">is origin chain in</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a function to the functional resonance where it appears in the origin chain.</rdfs:comment>
    <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Function"/>
    <rdfs:range rdf:resource="https://flowfram.com/ontology/fram/FunctionalResonance"/>
