    <rdfs:label xml:lang="en">Acceptable</rdfs:label>
    <rdfs:comment xml:lang="en">The function output is within acceptable bounds but not precise.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://flowfram.com/ontology/fram/distributionMax">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">distribution maximum</rdfs:label>
    <rdfs:comment xml:lang="en">The maximum value of a probability distribution.</rdfs:comment>
    <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Distribution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
