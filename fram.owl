  </rdf:Description>
  <rdf:Description rdf:about="https://flowfram.com/ontology/fram/distributionMean">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">distribution mean</rdfs:label>
