      <owl:ObjectProperty rdf:about="https://flowfram.com/ontology/fram/hasVariability">
        <rdfs:label xml:lang="en">has variability</rdfs:label>
        <rdfs:comment xml:lang="en">Relates a function output to its variability characterization.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Function"/>
        <rdfs:range rdf:resource="https://flowfram.com/ontology/fram/Variability"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
  </owl:ObjectProperty>
