    <rdfs:label xml:lang="en">variability propagation</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a coupling to a description of how variability propagates through it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Coupling"/>
    <rdfs:range rdf:resource="https://flowfram.com/ontology/fram/VariabilityPropagation"/>
    <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/dataType">
    <rdfs:label xml:lang="en">data type</rdfs:label>
    <rdfs:comment xml:lang="en">The XSD data type of a value (e.g., xsd:decimal, xsd:string).</rdfs:comment>
    <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Constant"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/factors">
    <rdfs:label xml:lang="en">factors</rdfs:label>
    <rdfs:comment xml:lang="en">Factors affecting variability of a function.</rdfs:comment>
    <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Variability"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/isCustomActivation">
    <rdfs:label xml:lang="en">is custom activation</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the interpretation profile uses a custom activation expression.</rdfs:comment>
    <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/InterpretationProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://flowfram.com/ontology/fram/methodologyContext">
    <rdfs:label xml:lang="en">methodology context</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a FRAM model to its FRAM methodology context information.</rdfs:comment>
    <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/FRAMModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/activationCondition">
    <rdfs:label xml:lang="en">activation condition</rdfs:label>
