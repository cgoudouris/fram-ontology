        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://flowfram.com/ontology/fram/isTargetAspectOf">
        <rdfs:label xml:lang="en">is target aspect of</rdfs:label>
        <rdfs:comment xml:lang="en">Relates an aspect back to the coupling where it is the target.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Aspect"/>
        <rdfs:range rdf:resource="https://flowfram.com/ontology/fram/Coupling"/>
