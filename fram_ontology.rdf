    <owl:ObjectProperty rdf:about="https://flowfram.com/ontology/fram/isConstantOf">
        <rdfs:label xml:lang="en">is constant of</rdfs:label>
        <rdfs:comment xml:lang="en">Relates a constant back to its parent function.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Constant"/>
        <rdfs:range rdf:resource="https://flowfram.com/ontology/fram/Function"/>
        <owl:inverseOf rdf:resource="https://flowfram.com/ontology/fram/hasConstant"/>
