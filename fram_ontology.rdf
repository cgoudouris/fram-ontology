    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/aspectType">
        <rdfs:label xml:lang="en">aspect type</rdfs:label>
        <rdfs:comment xml:lang="en">The type code of an aspect: I (Input), O (Output), P (Precondition), R (Resource), C (Control), or T (Time).</rdfs:comment>
