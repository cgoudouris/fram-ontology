        <rdfs:label xml:lang="en">distribution mean</rdfs:label>
        <rdfs:comment xml:lang="en">The mean value of a probability distribution.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Distribution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/distributionStdDev">
