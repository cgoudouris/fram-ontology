        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/distributionMax">
        <rdfs:label xml:lang="en">distribution maximum</rdfs:label>
        <rdfs:comment xml:lang="en">The maximum value of a probability distribution.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Distribution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/timingPhenotype">
        <rdfs:label xml:lang="en">timing phenotype</rdfs:label>
        <rdfs:comment xml:lang="en">The timing dimension of variability: too-early, on-time, too-late, or not-at-all.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Variability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/precisionPhenotype">
        <rdfs:label xml:lang="en">precision phenotype</rdfs:label>
        <rdfs:comment xml:lang="en">The precision dimension of variability: precise, acceptable, or imprecise.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Variability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/expression">
        <rdfs:label xml:lang="en">expression</rdfs:label>
        <rdfs:comment xml:lang="en">A mathematical expression or formula associated with variability calculations.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Distribution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/formula">
