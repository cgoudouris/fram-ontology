    <!-- Additional Datatype Properties -->

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/variabilityType">
        <rdfs:label xml:lang="en">variability type</rdfs:label>
        <rdfs:comment xml:lang="en">The type of variability: Internal, External, Upstream, or Downstream.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Variability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/functionCategory">
        <rdfs:label xml:lang="en">function category</rdfs:label>
        <rdfs:comment xml:lang="en">An additional categorization of the function beyond its basic type.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Function"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/couplingType">
        <rdfs:label xml:lang="en">coupling type</rdfs:label>
        <rdfs:comment xml:lang="en">The semantic type of a coupling (e.g., informational, material, temporal).</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Coupling"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/value">
        <rdfs:label xml:lang="en">value</rdfs:label>
        <rdfs:comment xml:lang="en">The value of a constant or result of a computation.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Constant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anySimpleType"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/unit">
        <rdfs:label xml:lang="en">unit</rdfs:label>
        <rdfs:comment xml:lang="en">The measurement unit of a constant or variable value.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Constant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/dataType">
        <rdfs:label xml:lang="en">data type</rdfs:label>
        <rdfs:comment xml:lang="en">The XSD data type of a value (e.g., xsd:decimal, xsd:string).</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Constant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/codeType">
        <rdfs:label xml:lang="en">code type</rdfs:label>
        <rdfs:comment xml:lang="en">The type of code for a variable expression: 'expression' or 'block'.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Variable"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/semanticRole">
        <rdfs:label xml:lang="en">semantic role</rdfs:label>
        <rdfs:comment xml:lang="en">The semantic role of an aspect or coupling within the FRAM methodology.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Aspect"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/semanticMeaning">
        <rdfs:label xml:lang="en">semantic meaning</rdfs:label>
        <rdfs:comment xml:lang="en">A semantic description of the meaning of a constant or variable in the FRAM model context.</rdfs:comment>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="https://flowfram.com/ontology/fram/Constant"/>
                    <owl:Class rdf:about="https://flowfram.com/ontology/fram/Variable"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/position">
        <rdfs:label xml:lang="en">position</rdfs:label>
        <rdfs:comment xml:lang="en">The visual position (x, y coordinates) of a function in the FRAM diagram.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Function"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/edgeId">
        <rdfs:label xml:lang="en">edge ID</rdfs:label>
        <rdfs:comment xml:lang="en">The internal identifier of a coupling edge in the visual editor.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/OutputMessage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/activationCondition">
        <rdfs:label xml:lang="en">activation condition</rdfs:label>
        <rdfs:comment xml:lang="en">A condition expression that determines when a function output is activated.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Function"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/sourceType">
        <rdfs:label xml:lang="en">source type</rdfs:label>
        <rdfs:comment xml:lang="en">The source type of a variable: 'calculated' or 'external'.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Variable"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/externalKey">
        <rdfs:label xml:lang="en">external key</rdfs:label>
        <rdfs:comment xml:lang="en">The flow context key for an external variable (e.g., 'sim_iteration').</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Variable"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/amplification">
        <rdfs:label xml:lang="en">amplification</rdfs:label>
        <rdfs:comment xml:lang="en">The amplification factor for variability propagation through a coupling.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Coupling"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/analysisScope">
        <rdfs:label xml:lang="en">analysis scope</rdfs:label>
        <rdfs:comment xml:lang="en">The scope of the FRAM analysis.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/FRAMModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/analysisFocus">
        <rdfs:label xml:lang="en">analysis focus</rdfs:label>
        <rdfs:comment xml:lang="en">The focus area of the FRAM analysis.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/FRAMModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://flowfram.com/ontology/fram/phenotypeValue">
        <rdfs:label xml:lang="en">phenotype value</rdfs:label>
        <rdfs:comment xml:lang="en">The value of a phenotype (e.g., TooEarly, OnTime, Precise).</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Phenotype"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:DatatypeProperty>

    <!-- =================================================================== -->
    <!-- P10 FIX: DISJOINTNESS AXIOMS (v1.1.0)                               -->
    <!-- =================================================================== -->

    <!-- Function type subclasses are mutually disjoint -->
    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/HumanFunction"/>
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/TechnologicalFunction"/>
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/OrganisationalFunction"/>
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/BackgroundFunction"/>
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/EntryFunction"/>
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/ExitFunction"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <!-- Aspect type subclasses are mutually disjoint -->
    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/InputAspect"/>
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/OutputAspect"/>
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/PreconditionAspect"/>
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/ResourceAspect"/>
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/ControlAspect"/>
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/TimeAspect"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <!-- Phenotype subclasses are mutually disjoint -->
    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/TimingPhenotype"/>
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/PrecisionPhenotype"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <!-- Distribution subclasses are mutually disjoint -->
    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/NormalDistribution"/>
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/UniformDistribution"/>
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/TriangularDistribution"/>
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/LogNormalDistribution"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <!-- Variability type subclasses are mutually disjoint -->
    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/UpstreamVariability"/>
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/DownstreamVariability"/>
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/InternalVariability"/>
            <owl:Class rdf:about="https://flowfram.com/ontology/fram/ExternalVariability"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <!-- =================================================================== -->
    <!-- P13 FIX: INVERSE RELATIONSHIPS (v1.1.0)                              -->
    <!-- =================================================================== -->

    <owl:ObjectProperty rdf:about="https://flowfram.com/ontology/fram/isFunctionOf">
        <rdfs:label xml:lang="en">is function of</rdfs:label>
        <rdfs:comment xml:lang="en">Relates a function back to its parent FRAM model.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Function"/>
        <rdfs:range rdf:resource="https://flowfram.com/ontology/fram/FRAMModel"/>
        <owl:inverseOf rdf:resource="https://flowfram.com/ontology/fram/hasFunction"/>
        <rdfs:isDefinedBy rdf:resource="https://flowfram.com/ontology/fram/"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://flowfram.com/ontology/fram/isCouplingOf">
        <rdfs:label xml:lang="en">is coupling of</rdfs:label>
        <rdfs:comment xml:lang="en">Relates a coupling back to its parent FRAM model.</rdfs:comment>
        <rdfs:domain rdf:resource="https://flowfram.com/ontology/fram/Coupling"/>
        <rdfs:range rdf:resource="https://flowfram.com/ontology/fram/FRAMModel"/>
        <owl:inverseOf rdf:resource="https://flowfram.com/ontology/fram/hasCoupling"/>
