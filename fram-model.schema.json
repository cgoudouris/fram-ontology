{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowfram.com/ontology/fram/fram-model.schema.json",
  "title": "FRAM Model",
  "description": "JSON Schema for validating FRAM (Functional Resonance Analysis Method) models serialized as JSON-LD. Complements the OWL ontology (fram.ttl) and JSON-LD context (context.jsonld).",
  "type": "object",

  "required": ["@context", "@type", "name", "hasFunction"],
  "additionalProperties": true,

  "properties": {
    "@context": {
      "description": "JSON-LD context reference. Must point to the FRAM ontology context.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object" },
        {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "object" }
            ]
          }
        }
      ]
    },
    "@type": {
      "description": "Must include 'FRAMModel'.",
      "oneOf": [
        { "const": "FRAMModel" },
        {
          "type": "array",
          "contains": { "const": "FRAMModel" }
        }
      ]
    },
    "@id": {
      "type": "string",
      "description": "Unique IRI identifier for this model."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable name of the FRAM model."
    },
    "description": {
      "type": "string",
      "description": "Free-text description of the model scope and purpose."
    },
    "creator": {
      "type": "string",
      "description": "Author or organization that created the model."
    },
    "author": {
      "type": "string",
      "description": "Alternative to 'creator' (schema:author)."
    },
    "dateCreated": {
      "type": "string",
      "description": "ISO 8601 date when the model was created.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "dateModified": {
      "type": "string",
      "description": "ISO 8601 date when the model was last modified.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "version": {
      "type": "string",
      "description": "Semantic version string (e.g. '1.0', '2.1.3')."
    },
    "analysisType": {
      "type": "string",
      "enum": ["prospective", "retrospective", "exploratory"],
      "description": "Type of FRAM analysis: prospective (risk), retrospective (incident), or exploratory."
    },
    "analysisScope": {
      "type": "string",
      "description": "Scope or boundary of the analysis."
    },
    "analysisFocus": {
      "type": "string",
      "description": "Primary focus area of the analysis."
    },
    "keywords": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ],
      "description": "Keywords or tags for the model."
    },

    "hasFunction": {
      "type": "array",
      "minItems": 1,
      "description": "The set of functions in this FRAM model. A valid model must contain at least one function.",
      "items": { "$ref": "#/$defs/Function" }
    },
    "hasCoupling": {
      "type": "array",
      "description": "The set of couplings (connections) between functions.",
      "items": { "$ref": "#/$defs/Coupling" }
    },
    "hasScenario": {
      "type": "array",
      "description": "Named scenario variants of this model.",
      "items": { "$ref": "#/$defs/Scenario" }
    },
    "scenariosEnabled": {
      "type": "boolean",
      "description": "Whether the scenario comparison feature is enabled for this model."
    },
    "scenarioCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of scenarios defined."
    },

    "summary": { "type": "string" },
    "functionCount": { "type": "integer", "minimum": 0 },
    "couplingCount": { "type": "integer", "minimum": 0 },
    "functionsByType": { "type": "object" },
    "couplingsByAspect": { "type": "object" },
    "averageConnectionsPerFunction": { "type": "number" },
    "maxConnectionsFunction": { "type": "string" },

    "analysisHints": { "type": "object" },
    "analysisInsights": {},
    "analysisRecommendations": {},
    "analysisQuestions": {},
    "systemBoundaries": {},
    "entryPoints": {},
    "exitPoints": {},
    "potentialResonancePoints": {},
    "variabilityHotspots": {},
    "methodologyContext": {},
    "framPrinciples": {},
    "quantitativeMetadata": {}
  },

  "$defs": {
    "Function": {
      "type": "object",
      "description": "A FRAM function — an activity or task performed by a human, technological, or organisational agent.",
      "required": ["@type", "name"],
      "additionalProperties": true,
      "properties": {
        "@type": {
          "description": "Must include 'Function' and optionally a subclass.",
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "Function",
                "HumanFunction",
                "TechnologicalFunction",
                "OrganisationalFunction",
                "BackgroundFunction",
                "EntryFunction",
                "ExitFunction",
                "ForegroundFunction"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Function",
                  "HumanFunction",
                  "TechnologicalFunction",
                  "OrganisationalFunction",
                  "BackgroundFunction",
                  "EntryFunction",
                  "ExitFunction",
                  "ForegroundFunction"
                ]
              },
              "contains": { "const": "Function" }
            }
          ]
        },
        "@id": {
          "type": "string",
          "description": "Unique identifier (IRI or blank node) for this function."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Descriptive name of the function (verb phrase recommended)."
        },
        "description": {
          "type": "string"
        },
        "functionType": {
          "type": "string",
          "enum": ["human", "technological", "organisational", "background"],
          "description": "Category of the function per FRAM methodology."
        },
        "functionCategory": {
          "type": "string",
          "enum": ["foreground", "background", "entry", "exit"],
          "description": "Role of the function in the model's execution flow."
        },
        "hasAspect": {
          "type": "array",
          "description": "The six characterizing aspects of this function (Input, Output, Precondition, Resource, Control, Time).",
          "items": { "$ref": "#/$defs/Aspect" }
        },
        "hasVariability": {
          "$ref": "#/$defs/Variability",
          "description": "Performance variability characterization for this function."
        },
        "hasPerformanceCondition": {
          "type": "array",
          "description": "Common Performance Conditions (CPCs) that influence this function's variability.",
          "items": { "$ref": "#/$defs/PerformanceCondition" }
        },
        "hasPhenotypeMappingRule": {
          "type": "array",
          "description": "Analyst-defined phenotype classification rules for this function.",
          "items": { "$ref": "#/$defs/PhenotypeMappingRule" }
        },
        "hasWAIWADComparison": {
          "type": "array",
          "description": "WAI/WAD comparison results for this function.",
          "items": { "$ref": "#/$defs/WAIWADComparison" }
        },
        "notes": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "examples": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      }
    },

    "Aspect": {
      "type": "object",
      "description": "One of the six characterizing aspects of a FRAM function.",
      "required": ["@type"],
      "additionalProperties": true,
      "properties": {
        "@type": {
          "type": "string",
          "enum": [
            "Aspect",
            "InputAspect",
            "OutputAspect",
            "PreconditionAspect",
            "ResourceAspect",
            "ControlAspect",
            "TimeAspect"
          ],
          "description": "The specific aspect type."
        },
        "@id": { "type": "string" },
        "name": {
          "type": "string",
          "description": "Descriptive label for this aspect (e.g. 'Water supply', 'Task request')."
        },
        "aspectType": {
          "type": "string",
          "enum": [
            "Input",
            "Output",
            "Precondition",
            "Resource",
            "Control",
            "Time"
          ],
          "description": "Canonical aspect type name."
        },
        "aspectCode": {
          "type": "string",
          "enum": ["I", "O", "P", "R", "C", "T"],
          "description": "Single-letter code for the aspect type."
        },
        "description": { "type": "string" }
      }
    },

    "Coupling": {
      "type": "object",
      "description": "A directed connection between the Output aspect of one function and an Input/Precondition/Resource/Control/Time aspect of another function.",
      "required": ["@type", "sourceFunction", "targetFunction"],
      "additionalProperties": true,
      "properties": {
        "@type": {
          "description": "Must be 'Coupling'.",
          "oneOf": [
            { "const": "Coupling" },
            { "type": "array", "contains": { "const": "Coupling" } }
          ]
        },
        "@id": { "type": "string" },
        "label": {
          "type": "string",
          "description": "Human-readable label for the coupling."
        },
        "sourceFunction": {
          "type": "string",
          "description": "IRI or @id of the source function (the one producing output)."
        },
        "targetFunction": {
          "type": "string",
          "description": "IRI or @id of the target function (the one receiving input)."
        },
        "sourceAspect": {
          "$ref": "#/$defs/AspectRef",
          "description": "The source aspect (typically Output)."
        },
        "targetAspect": {
          "$ref": "#/$defs/AspectRef",
          "description": "The target aspect (Input, Precondition, Resource, Control, or Time)."
        },
        "couplingStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Strength of the coupling on a [0, 1] scale. 1.0 = fully coupled."
        },
        "couplingType": {
          "type": "string",
          "description": "Semantic classification of the coupling."
        },
        "semanticRole": { "type": "string" },
        "semanticMeaning": { "type": "string" },
        "variabilityPropagation": { "type": "string" },
        "propagates": { "type": "boolean" }
      }
    },

    "AspectRef": {
      "description": "A reference to a specific aspect, used in couplings to identify source/target aspect types.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "@type": {
              "type": "string",
              "enum": [
                "Aspect",
                "InputAspect",
                "OutputAspect",
                "PreconditionAspect",
                "ResourceAspect",
                "ControlAspect",
                "TimeAspect"
              ]
            },
            "@id": { "type": "string" },
            "aspectCode": {
              "type": "string",
              "enum": ["I", "O", "P", "R", "C", "T"]
            },
            "aspectType": {
              "type": "string",
              "enum": [
                "Input",
                "Output",
                "Precondition",
                "Resource",
                "Control",
                "Time"
              ]
            }
          },
          "additionalProperties": true
        }
      ]
    },

    "Variability": {
      "type": "object",
      "description": "Performance variability characterization for a function, including qualitative phenotypes and optional quantitative distributions.",
      "additionalProperties": true,
      "properties": {
        "@type": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "Variability",
                "InternalVariability",
                "ExternalVariability",
                "UpstreamVariability",
                "DownstreamVariability"
              ]
            },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "variabilityPotential": {
          "type": "string",
          "enum": ["very-low", "low", "medium", "high", "very-high"],
          "description": "Qualitative assessment of how much this function's output can vary."
        },
        "variabilityType": {
          "type": "string",
          "enum": ["internal", "external", "upstream", "downstream"],
          "description": "Source of the variability."
        },
        "timingPhenotype": {
          "type": "string",
          "enum": ["too-early", "on-time", "too-late", "not-at-all"],
          "description": "Dominant timing phenotype."
        },
        "precisionPhenotype": {
          "type": "string",
          "enum": ["precise", "acceptable", "imprecise"],
          "description": "Dominant precision phenotype."
        },
        "hasPhenotype": {
          "type": "array",
          "description": "Detailed phenotype specifications with probabilities.",
          "items": { "$ref": "#/$defs/Phenotype" }
        }
      }
    },

    "Phenotype": {
      "type": "object",
      "description": "A specific variability phenotype with its probability of occurrence.",
      "additionalProperties": true,
      "properties": {
        "@type": {
          "type": "string",
          "enum": [
            "Phenotype",
            "TimingPhenotypeClass",
            "PrecisionPhenotypeClass",
            "TimingPhenotype",
            "PrecisionPhenotype",
            "DurationPhenotype",
            "SequencePhenotype",
            "ForcePhenotype",
            "DistancePhenotype",
            "DirectionPhenotype"
          ]
        },
        "phenotypeValue": {
          "type": "string",
          "enum": [
            "too-early",
            "on-time",
            "too-late",
            "not-at-all",
            "precise",
            "acceptable",
            "imprecise",
            "too-short",
            "appropriate",
            "too-long",
            "correct-order",
            "wrong-order",
            "skipped",
            "repeated",
            "too-low",
            "on-target",
            "too-high"
          ],
          "description": "The phenotype category."
        },
        "phenotypeProbability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Probability of this phenotype [0, 1]."
        }
      }
    },

    "PerformanceCondition": {
      "type": "object",
      "description": "A Common Performance Condition (CPC) that influences a function's variability.",
      "additionalProperties": true,
      "properties": {
        "@type": {
          "oneOf": [
            { "const": "PerformanceCondition" },
            { "type": "array", "contains": { "const": "PerformanceCondition" } }
          ]
        },
        "@id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "value": { "type": "string" },
        "factors": {}
      }
    },

    "Scenario": {
      "type": "object",
      "description": "A named scenario variant of the FRAM model with its own function/coupling configuration.",
      "additionalProperties": true,
      "properties": {
        "@type": {
          "oneOf": [
            { "const": "FRAMScenario" },
            { "type": "array", "contains": { "const": "FRAMScenario" } }
          ]
        },
        "@id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "comment": { "type": "string" },
        "hasFunction": {
          "type": "array",
          "items": { "$ref": "#/$defs/Function" }
        },
        "hasCoupling": {
          "type": "array",
          "items": { "$ref": "#/$defs/Coupling" }
        }
      }
    },

    "PhenotypeMappingRule": {
      "type": "object",
      "description": "A rule that maps a metadata variable to phenotype classifications along a variability dimension.",
      "required": ["@type", "mapsToVariable", "mapsToDimension"],
      "additionalProperties": true,
      "properties": {
        "@type": {
          "oneOf": [
            { "const": "PhenotypeMappingRule" },
            { "type": "array", "contains": { "const": "PhenotypeMappingRule" } }
          ]
        },
        "@id": { "type": "string" },
        "mapsToVariable": {
          "type": "string",
          "description": "The metadata variable or expression whose values are classified."
        },
        "mapsToDimension": {
          "type": "string",
          "description": "IRI or short name of the variability dimension (e.g. 'TimingDimension')."
        },
        "hasWAIDeclaration": {
          "$ref": "#/$defs/WAIDeclaration",
          "description": "The analyst's expected (Work-as-Imagined) phenotype."
        },
        "hasEmergentResult": {
          "$ref": "#/$defs/EmergentPhenotypeResult",
          "description": "The observed (Work-as-Done) phenotype distribution."
        }
      }
    },

    "WAIDeclaration": {
      "type": "object",
      "description": "The analyst's expected phenotype declaration (Work-as-Imagined).",
      "required": ["@type", "dominantPhenotype", "waiConfidence"],
      "additionalProperties": true,
      "properties": {
        "@type": {
          "oneOf": [
            { "const": "WAIDeclaration" },
            { "type": "array", "contains": { "const": "WAIDeclaration" } }
          ]
        },
        "@id": { "type": "string" },
        "dominantPhenotype": {
          "type": "string",
          "description": "The expected dominant phenotype category."
        },
        "waiConfidence": {
          "type": "string",
          "enum": ["Low", "Medium", "High"],
          "description": "Analyst's self-assessed confidence in the WAI declaration."
        },
        "waiRationale": {
          "type": "string",
          "description": "Free-text justification for the WAI expectation."
        }
      }
    },

    "EmergentPhenotypeResult": {
      "type": "object",
      "description": "The observed phenotype distribution from simulation (Work-as-Done).",
      "additionalProperties": true,
      "properties": {
        "@type": {
          "oneOf": [
            { "const": "EmergentPhenotypeResult" },
            {
              "type": "array",
              "contains": { "const": "EmergentPhenotypeResult" }
            }
          ]
        },
        "@id": { "type": "string" },
        "dominantPhenotype": {
          "type": "string",
          "description": "The most frequently observed phenotype category."
        },
        "dominantProbability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Probability of the dominant phenotype."
        },
        "sampleSize": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of simulation iterations classified."
        }
      }
    },

    "WAIWADComparison": {
      "type": "object",
      "description": "A comparison between expected (WAI) and observed (WAD) phenotypes.",
      "additionalProperties": true,
      "properties": {
        "@type": {
          "oneOf": [
            { "const": "WAIWADComparison" },
            { "type": "array", "contains": { "const": "WAIWADComparison" } }
          ]
        },
        "@id": { "type": "string" },
        "discordanceIndex": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Δ(WAI-WAD) = 1 - P_WAD(c_WAI). Range [0, 1]."
        },
        "concordanceLevel": {
          "type": "string",
          "enum": ["full", "partial", "discordant"],
          "description": "Qualitative concordance classification."
        }
      }
    }
  }
}
